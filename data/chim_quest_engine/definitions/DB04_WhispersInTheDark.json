    "quest_editor_id":  "DB04",
    "title":  "Whispers in the Dark",
    "description":  "Astrid suspects Cicero is conspiring with someone in the Sanctuary and asks the player to hide in the Night Mother\u0027s coffin to eavesdrop. Inside, the Night Mother speaks and names the player Listener, directing them to Volunruud to speak with Amaund Motierre. Astrid is unsettled by the revelation and sends the player to Nazir for side contracts while she processes the news.",
    "npc_facts":  {
                      "Astrid":  {
                                     "base_facts":  [
                                                        "I am the leader of the Dark Brotherhood Sanctuary.",
                                                        "I trust my own judgment over the Old Ways.",
                                                        "I am married to Arnbjorn."
                                                    ],
                                     "beat_facts":  {
                                                        "ASTRID_REQUEST":  [
                                                                               "I suspect Cicero is conspiring with someone against the Sanctuary.",
                                                                               "I asked the new recruit to hide in the Night Mother\u0027s coffin and eavesdrop on Cicero."
                                                                           ],
                                                        "REPORT_TO_ASTRID":  [
                                                                                 "The Night Mother supposedly named the recruit as Listener. I am unsure what to believe.",
                                                                                 "I am still the leader of this family, regardless of the Night Mother\u0027s choice."
                                                                             ],
                                                        "NAZIR_SIDE_CONTRACT":  [
                                                                                    "I need time to process the Listener revelation. I sent the recruit to Nazir for side contracts."
                                                                                ]
                                                    }
                                 },
                      "Cicero":  {
                                     "base_facts":  [
                                                        "I am the Keeper of the Night Mother.",
                                                        "I am devoted to the Night Mother and the Old Ways.",
                                                        "I have been trying to hear the Night Mother speak for so long."
                                                    ],
                                     "beat_facts":  {
                                                        "NIGHT_MOTHER_REVELATION":  [
                                                                                        "The Night Mother has finally spoken! She named the recruit as the Listener!",
                                                                                        "Darkness rises when silence dies!"
                                                                                    ]
                                                    }
                                 },
                      "Nazir":  {
                                    "base_facts":  [
                                                       "I am a Redguard assassin of the Dark Brotherhood.",
                                                       "I provide side contracts to Sanctuary members."
                                                   ],
                                    "beat_facts":  {
                                                       "NAZIR_SIDE_CONTRACT":  [
                                                                                   "I have given the recruit side contracts to complete while Astrid sorts things out."
                                                                               ]
                                                   }
                                },
                      "Night Mother":  {
                                           "base_facts":  [
                                                              "I am the Night Mother, the spiritual leader of the Dark Brotherhood.",
                                                              "I communicate only with the Listener."
                                                          ],
                                           "beat_facts":  {
                                                              "NIGHT_MOTHER_REVELATION":  [
                                                                                              "I have named the recruit as the Listener.",
                                                                                              "I have tasked the Listener to go to Volunruud and speak with Amaund Motierre."
                                                                                          ]
                                                          }
                                       }
