    "title":  "Reluctant Steward",
    "description":  "Neloth\u0027s steward Varona Nelas has gone missing from Tel Mithryn. Find her, and if the worst has happened, recruit a willing replacement from Raven Rock.",
    "npc_facts":  {
                      "Neloth":  {
                                     "base_facts":  [
                                                        "I am a master wizard of House Telvanni and the founder of Tel Mithryn.",
                                                        "I expect my servants to attend to my needs, including brewing canis root tea.",
                                                        "My steward Varona Nelas has gone missing and I need her found immediately."
                                                    ],
                                     "beat_facts":  {
                                                        "NEELOTH_REQUESTS_HELP":  [
                                                                                      "I have sent someone to find my missing steward Varona. I want my apple cabbage stew and canis root tea."
                                                                                  ],
                                                        "REPORT_NELOTH_VARONA_DEAD":  [
                                                                                          "Varona is dead, killed by ash spawn. I need a new steward from Raven Rock. They are in awe of me there."
                                                                                      ],
                                                        "QUEST_COMPLETE":  [
                                                                               "Drovas Relvi is my new steward. He makes dreadful canis root tea but runs the place well enough.",
                                                                               "I have granted access to my staff enchanter as reward for finding me a new steward."
                                                                           ]
                                                    }
                                 },
                      "Varona Nelas":  {
                                           "base_facts":  [
                                                              "I am Neloth\u0027s steward at Tel Mithryn.",
                                                              "Neloth is very demanding and constantly sends me on errands."
                                                          ],
                                           "beat_facts":  {

                                                          }
                                       },
                      "Drovas Relvi":  {
                                           "base_facts":  [
                                                              "I work as a cook at the Retching Netch in Raven Rock.",
                                                              "Geldis Sadri won\u0027t let me drink on the job.",
                                                              "I owe money to Mogrul and would like to leave Raven Rock."
                                                          ],
                                           "beat_facts":  {
                                                              "DROVAS_ACCEPTS_POSITION":  [
                                                                                              "I have accepted the position as Neloth\u0027s new steward at Tel Mithryn.",
                                                                                              "Leaving Raven Rock also helps me escape my debt to Mogrul."
                                                                                          ]
                                                          }
                                       },
                      "Elynea Mothren":  {
                                             "base_facts":  [
