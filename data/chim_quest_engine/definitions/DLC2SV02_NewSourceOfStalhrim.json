                                                 "base_facts":  [
                                                                    "I am the blacksmith of Skaal Village, skilled in forging Stalhrim.",
                                                                    "Stalhrim is enchanted ice as hard as iron and cold as death; only Skaal smiths know the art of forging it."
                                                                ],
                                                 "beat_facts":  {
                                                                    "FIND_BALDOR":  [
                                                                                        "The Thalmor elves abducted me to learn the secrets of forging Stalhrim.",
                                                                                        "Their leader Ancarion has a map showing a hidden source of Stalhrim.",
                                                                                        "I asked the traveler to retrieve the map from Ancarion\u0027s ship at Northshore Landing."
                                                                                    ],
                                                                    "COMPLETE_QUEST":  [
                                                                                           "The traveler returned the Stalhrim Source Map to me.",
                                                                                           "I have taught the traveler how to smith Stalhrim as gratitude."
                                                                                       ]
                                                                }
                                             },
