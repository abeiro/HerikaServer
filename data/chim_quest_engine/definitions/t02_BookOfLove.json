{
  "quest_key": "t02_bookoflove",
  "skeleton_type": "quest",
  "quest_form_id": "0x000211D5",
  "quest_plugin": "Skyrim.esm",
  "quest_editor_id": "t02",
  "title": "The Book of Love",
  "description": "Help the Temple of Mara spread love throughout Skyrim by aiding Fastred in Ivarstead, Calcelmo in Markarth, and reuniting the ghostly lovers Ruki and Fenrig.",
  "npc_facts": {
    "Dinya Balu": {
      "base_facts": [
        "I am a priestess of Mara at the Temple of Mara in Riften.",
        "Mara has given me visions of those who need help with love.",
        "I ask travelers to act in Mara's name to aid troubled lovers."
      ],
      "beat_facts": {
        "IVARSTEAD_COMPLETE": [
          "The traveler helped Fastred find love in Ivarstead."
        ],
        "MARKARTH_COMPLETE": [
          "The traveler helped Calcelmo and Faleen find each other in Markarth."
        ],
        "GHOSTS_COMPLETE": [
          "The traveler reunited the ghostly lovers Ruki and Fenrig beyond death itself."
        ],
        "QUEST_COMPLETE": [
          "Mara's blessing has been bestowed upon the traveler for their service to love.",
          "Quest finished. Dinya bestows Mara's blessing and the Agent of Mara reward.",
          "Speak to Ruki then when you talk to Fenrig simply allow him to finish his lines.",
          "The man you speak with will then proceed to meet with Fastred; they'll have a brief conversation which you must observe to advance the quest and ensure Mara's work is done."
        ]
      }
    },
    "Fastred": {
      "base_facts": [
        "I live in Ivarstead with my parents Boti and Jofthor.",
        "I am in love with Bassianus Axius but my father disapproves."
      ],
      "beat_facts": {
        "IVARSTEAD_COMPLETE": [
          "I have found love and left Ivarstead with Bassianus."
        ]
      }
    },
    "Calcelmo": {
      "base_facts": [
        "I am a scholar and Dwemer researcher in Markarth.",
        "I am hopelessly undone by Faleen but cannot bring myself to speak to her."
      ],
      "beat_facts": {
        "MARKARTH_COMPLETE": [
          "Faleen and I have confessed our love for each other."
        ]
      }
    },
    "Faleen": {
      "base_facts": [
        "I am a Redguard warrior and housecarl in Markarth.",
        "Yngvar the Singer is my friend."
      ],
      "beat_facts": {
        "MARKARTH_COMPLETE": [
          "Calcelmo and I have confessed our love for each other."
        ]
      }
    },
    "Ruki": {
      "base_facts": [
        "I am a ghost searching for my love Fenrig at Gjukar's Monument.",
        "I believe I am still alive and looking for Fenrig after a battle."
      ],
      "beat_facts": {
        "GHOSTS_COMPLETE": [
          "Fenrig and I have been reunited and ascended into the sky together."
        ]
      }
    },
    "Fenrig": {
      "base_facts": [
        "I am a ghost near Fort Greymoor, believing I am still alive and camping with Gjukar's army.",
        "I was killed in an enemy raid the night before a battle."
      ],
      "beat_facts": {
        "GHOSTS_COMPLETE": [
          "Ruki and I have been reunited and ascended into the sky together."
        ]
      }
    }
  },
