    "quest_editor_id":  "MQ301",
    "title":  "The Fallen",
    "description":  "After defeating Alduin at the Throat of the World, the World-Eater fled. The Dragonborn must trap one of Alduin\u0027s dragon allies at Dragonsreach to learn the location of his lair, navigating the civil war if necessary to gain the Jarl of Whiterun\u0027s cooperation.",
    "npc_facts":  {
                      "Paarthurnax":  {
                                          "base_facts":  [
                                                             "Dragonsreach was once used to imprison a dragon by the ancient Nords.",
                                                             "A dragon\u0027s name is a Word of Power that can be Shouted to summon it.",
                                                             "Odahviing is one of Alduin\u0027s allies who may be called."
                                                         ],
                                          "beat_facts":  {
                                                             "SEEK_COUNCIL":  [
                                                                                  "The Dragonborn has asked how to find Alduin after he fled the Throat of the World."
                                                                              ],
                                                             "LEARN_CALL_DRAGON":  [
                                                                                       "I have shared the name Odahviing so the Dragonborn can call him."
                                                                                   ]
                                                         }
                                      },
                      "Arngeir":  {
                                      "base_facts":  [
                                                         "Dragonsreach was once used to capture a dragon.",
                                                         "The Greybeards can host a peace council to negotiate a civil war truce."
                                                     ],
                                      "beat_facts":  {
                                                         "SEEK_COUNCIL":  [
                                                                              "The Dragonborn seeks a way to track Alduin after he fled."
                                                                          ],
                                                         "NEGOTIATE_TRUCE":  [
                                                                                 "I have agreed to host the peace negotiations at High Hrothgar."
                                                                             ]
                                                     }
                                  },
                      "Esbern":  {
                                     "base_facts":  [
                                                        "The Blades\u0027 records contain the names of dragons.",
                                                        "A dragon\u0027s name can be used as a Shout to summon it."
                                                    ],
                                     "beat_facts":  {
                                                        "SEEK_COUNCIL":  [
                                                                             "The Dragonborn seeks a way to track Alduin."
                                                                         ],
                                                        "LEARN_CALL_DRAGON":  [
                                                                                  "I have revealed the name Odahviing from the Blades\u0027 records."
                                                                              ]
                                                    }
                                 },
                      "Odahviing":  {
                                        "base_facts":  [
                                                           "I am one of Alduin\u0027s allies.",
                                                           "I was curious to test the Dragonborn\u0027s power when called."
                                                       ],
                                        "beat_facts":  {
                                                           "TRAP_ODAHVIING":  [
                                                                                  "I have been trapped in the Dragonsreach yoke."
                                                                              ],
                                                           "INTERROGATE_ODAHVIING":  [
                                                                                         "Alduin\u0027s lair is at Skuldafn, an ancient Dragon Cult temple reachable only by air.",
                                                                                         "I will fly the Dragonborn to Skuldafn if released."
                                                                                     ]
                                                       }
                                    }
