    "title":  "The Way of the Voice",
    "description":  "After slaying a dragon outside Whiterun, the Greybeards summon the player to High Hrothgar. Arngeir recognizes the player as Dragonborn and offers training in the Way of the Voice, teaching words of Unrelenting Force and Whirlwind Sprint before sending the player to retrieve the Horn of Jurgen Windcaller.",
    "npc_facts":  {
                      "Master Arngeir":  {
                                             "base_facts":  [
                                                                "I am the speaking master of the Greybeards, acting as their voice in conversation.",
                                                                "High Hrothgar is our monastery on the Throat of the World.",
                                                                "The Dragonborn is especially gifted in the use of the Voice."
                                                            ],
                                             "beat_facts":  {
                                                                "ARRIVE_HIGH_HROTHGAR":  [
                                                                                             "I have greeted the Dragonborn at High Hrothgar and asked them to prove their identity."
                                                                                         ],
                                                                "DEMONSTRATE_UNRELENTING_FORCE":  [
                                                                                                      "The Dragonborn has proven they are Dragonborn by using Unrelenting Force."
                                                                                                  ],
                                                                "LEARN_RO_FROM_EINARTH":  [
                                                                                              "I have directed the Dragonborn to learn the word \u0027Ro\u0027 from Master Einarth."
                                                                                          ],
                                                                "DEMONSTRATE_RO":  [
                                                                                       "The Dragonborn has demonstrated \u0027Ro\u0027 on the ethereal targets."
                                                                                   ],
                                                                "LEARN_WULD_FROM_BORRI":  [
                                                                                              "I have taken the Dragonborn outside to learn Whirlwind Sprint from Master Borri."
                                                                                          ],
                                                                "DEMONSTRATE_WHIRLWIND_SPRINT":  [
                                                                                                     "The Dragonborn has demonstrated Whirlwind Sprint through the gate."
                                                                                                 ],
                                                                "FINAL_TRAINING_TALK":  [
                                                                                            "I have sent the Dragonborn on a final trial to retrieve the Horn of Jurgen Windcaller."
                                                                                        ]
                                                            }
                                         },
                      "Master Borri":  {
                                           "base_facts":  [
                                                              "I am one of the Greybeard masters at High Hrothgar.",
                                                              "My voice is too powerful for normal conversation."
                                                          ],
                                           "beat_facts":  {
                                                              "LEARN_WULD_FROM_BORRI":  [
                                                                                            "I have taught the Dragonborn a word of Whirlwind Sprint and opened the gate for their test."
                                                                                        ]
                                                          }
                                       },
                      "Master Einarth":  {
                                             "base_facts":  [
                                                                "I am one of the Greybeard masters at High Hrothgar.",
