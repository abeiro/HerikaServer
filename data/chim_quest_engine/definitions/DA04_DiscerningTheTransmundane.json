  "quest_editor_id": "DA04",
  "title": "Discerning the Transmundane",
  "description": "A Daedric quest in which the player aids the mad scholar Septimus Signus in opening a Dwemer lockbox by transcribing an Elder Scroll's knowledge into a lexicon and harvesting blood from the mer races, ultimately receiving the Oghma Infinium from Hermaeus Mora.",
  "npc_facts": {
    "Septimus Signus": {
      "base_facts": [
        "I am a preeminent scholar of the Elder Scrolls, living in the northern ice fields.",
        "I have studied a Dwemer lockbox for years, believing it contains the heart of a god.",
        "I need an Elder Scroll's knowledge inscribed into a Dwemer lexicon to decipher the lockbox."
      ],
      "beat_facts": {
        "MET_SEPTIMUS": [
          "I have given the player an Attunement Sphere and a Blank Lexicon to transcribe at the Tower of Mzark in Blackreach."
        ],
        "LEXICON_RETURNED": [
          "The lexicon has been transcribed with the Scroll's knowledge. I now know I need blood from the mer races to open the lockbox."
        ],
        "BLOOD_HARVEST": [
          "I need blood from Altmer, Bosmer, Dunmer, Falmer, and Orsimer to create a dwarven blood mixture and open the lockbox."
        ],
        "BLOOD_RETURNED": [
          "The blood has been collected. I can finally open the lockbox and reveal the heart of a god!"
        ],
        "QUEST_COMPLETE": [
          "The lockbox contained only a book, not the Heart of a God. I was wrong."
        ]
      }
    },
    "Hermaeus Mora": {
      "base_facts": [
        "I am the Daedric Prince of Knowledge and Memory, also called Herma-Mora.",
        "I have been guiding Septimus Signus in his research through the Wretched Abyss."
      ],
      "beat_facts": {
        "LEXICON_RETURNED": [
          "I have revealed myself to the player. Septimus is a useful follower but will outlive his usefulness once the lockbox is opened."
        ],
        "QUEST_COMPLETE": [
          "The player has taken the Oghma Infinium and is now my champion. Its dangerous knowledge is unleashed once more."
        ]
      }
    }
  },
