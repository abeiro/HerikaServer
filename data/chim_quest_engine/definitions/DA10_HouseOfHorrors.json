                                                              ],
                                               "beat_facts":  {
                                                                  "QUEST_BEGUN":  [
                                                                                      "I agreed to help Tyranus investigate the abandoned house."
                                                                                  ],
                                                                  "TYRANUS_DEAD":  [
                                                                                       "Tyranus was driven mad by the Daedric presence in the house and attacked me. I had no choice but to kill him."
                                                                                   ]
                                                              }
                                           },
