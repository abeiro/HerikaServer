                                        "base_facts":  [
                                                           "Daedric Prince of Domination who seeks to harvest mortal souls for Coldharbour.",
                                                           "His altar in the Markarth abandoned house was desecrated by a priest of Boethiah."
                                                       ],
                                        "beat_facts":  {
                                                           "MOLAG_BAL_SPEAKS":  [
                                                                                    "Molag Bal trapped me at his altar and demanded I bring the priest of Boethiah to him.",
                                                                                    "He wants the priest to bend the knee and pledge his soul, not mere revenge."
                                                                                ],
                                                           "QUEST_COMPLETE":  [
                                                                                  "Molag Bal transformed the rusty mace into the Mace of Molag Bal and granted me its true power."
                                                                              ]
                                                       }
                                    },
