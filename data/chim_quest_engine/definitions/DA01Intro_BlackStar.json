    "quest_editor_id":  "DA01Intro",
    "title":  "The Black Star",
    "description":  "Aranea Ienith, a priestess of Azura, directs the player to find an elven mage who can turn the brightest star as black as night. The trail leads to Nelacar in Winterhold, who reveals the story of Malyn Varen and his corrupted experiments on Azura\u0027s Star at Ilinalta\u0027s Deep. After recovering the broken Star, the player must choose whether to return it to Aranea for Azura\u0027s purification or to Nelacar to forge a Black Soul Gem, then enter the Star itself to destroy Malyn Varen\u0027s soul.",
    "npc_facts":  {
                      "Aranea Ienith":  {
                                            "base_facts":  [
                                                               "I am a priestess of Azura and the last worshipper at her shrine in Skyrim.",
                                                               "Azura foresaw your arrival and shared a vision with me.",
                                                               "The vision speaks of an elven mage who can turn the brightest star as black as night.",
                                                               "I believe the elven mage can be found in Winterhold."
                                                           ],
                                            "beat_facts":  {
                                                               "VISIT_SHRINE":  [
                                                                                    "The player has come to the Shrine as Azura foretold and accepted the quest."
                                                                                ],
                                                               "CHOOSE_PATH":  [
                                                                                   "The player has chosen to return the Star to Azura for purification."
                                                                               ],
                                                               "QUEST_COMPLETE":  [
                                                                                      "Azura has purified the Star. I am free to follow my own path and may offer to travel with the player."
                                                                                  ]
                                                           }
                                        },
                      "Nelacar":  {
                                      "base_facts":  [
                                                         "I am a former colleague of Malyn Varen at the College of Winterhold.",
                                                         "Malyn Varen was experimenting on Azura\u0027s Star to save himself from a terminal illness.",
                                                         "Malyn killed a student and was banished from the College. He fled to Ilinalta\u0027s Deep.",
                                                         "I do not want the Star returned to Azura. It should be kept out of her reach."
                                                     ],
                                      "beat_facts":  {
                                                         "SPEAK_TO_NELACAR":  [
                                                                                  "The player knows about Azura\u0027s Star and Malyn Varen\u0027s experiments at Ilinalta\u0027s Deep."
                                                                              ],
                                                         "CHOOSE_PATH":  [
                                                                             "The player has chosen to bring the Star to me instead of Azura."
                                                                         ],
                                                         "QUEST_COMPLETE":  [
                                                                                "The Black Star is complete. An infinite Black Soul Gem capable of trapping any soul."
                                                                            ]
                                                     }
                                  }
                  },
