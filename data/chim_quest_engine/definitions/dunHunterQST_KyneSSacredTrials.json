  "quest_editor_id": "dunHunterQST",
  "title": "Kyne's Sacred Trials",
  "description": "Froki Whetted-Blade, an old Nord hunter at Froki's Shack, guides the player through the Sacred Trials of Kyne by hunting guardian beast spirits across Skyrim in three escalating rounds: lesser beasts, greater beasts, and finally a troll champion. Completing all trials earns Kyne's Token.",
  "npc_facts": {
    "Froki Whetted-Blade": {
      "base_facts": [
        "I am Froki Whetted-Blade, a hunter who follows the old Nordic traditions.",
        "I honor Kyne, the mother of men and gods, not the Divines.",
        "I despise the worship of the Divines and pine for the old ways.",
        "I live at Froki's Shack near The Guardian Stones.",
        "I lost my bow inside Graywinter Watch."
      ],
      "beat_facts": {
        "MEET_FROKI": [
          "A traveler has come to my shack. Perhaps they will listen to the old ways of Kyne."
        ],
        "FIRST_TRIALS_ASSIGNED": [
          "I have marked this hunter for the lesser guardian trials: the mudcrab, skeever, and wolf spirits."
        ],
        "FIRST_TRIALS_COMPLETE": [
          "The hunter has proven themselves against the lesser guardians and returned to me."
        ],
        "SECOND_TRIALS_ASSIGNED": [
          "This hunter is ready for the greater guardian trials: the bear, mammoth, and sabre cat spirits."
        ],
        "SECOND_TRIALS_COMPLETE": [
          "The hunter has bested the greater guardians. They are truly skilled."
        ],
        "FINAL_TRIAL_ASSIGNED": [
          "Only the troll guardian remains. The final and most dangerous trial of Kyne awaits inside Graywinter Watch."
        ],
        "TROLL_DEFEATED": [
          "The hunter has slain the troll guardian spirit. The Sacred Trials are nearly complete."
        ],
        "QUEST_COMPLETE": [
          "The hunter has completed all of Kyne's Sacred Trials. They have earned Kyne's Token and my respect.",
          "Player completed all Sacred Trials and received Kyne's Token.",
          "Detailed Walkthrough [ edit ] Visit Froki's Shack and speak to Froki , a hunter.",
          "If you agree, he'll grant you a blessing to seek out the guardian beasts of Skyrim and perform the Sacred Trials of Kyne."
        ]
      }
    }
  },
