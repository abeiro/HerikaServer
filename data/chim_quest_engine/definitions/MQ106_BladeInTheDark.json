                                                                                    ],
                                                          "SAHLOKNIR_SLAIN":  [
                                                                                  "The Dragonborn killed Sahloknir and absorbed its soul. They are Dragonborn."
                                                                              ],
                                                          "BLADES_REVEALED":  [
                                                                                  "I revealed myself as one of the last Blades to the Dragonborn.",
                                                                                  "I suspect the Thalmor are responsible for the return of the dragons.",
