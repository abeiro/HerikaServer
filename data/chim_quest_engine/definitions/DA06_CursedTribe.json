  "title": "The Cursed Tribe",
  "description": "Help the cursed Orcs of Largashbur by aiding wise woman Atub in contacting Malacath, then assist Chief Yamarz in reclaiming the desecrated shrine from giants.",
  "npc_facts": {
    "Atub": {
      "base_facts": [
        "I am the wise woman of the Orc stronghold Largashbur.",
        "Our tribe has been cursed and giants attack us openly.",
        "I need a Daedra Heart and Troll Fat to perform a ritual to contact Malacath."
      ],
      "beat_facts": {
        "GATHER_INGREDIENTS": [
          "The player has brought me the ingredients for the ritual."
        ],
        "MALACATHS_JUDGMENT": [
          "Malacath has spoken through the ritual and demands Yamarz reclaim the shrine."
        ]
      }
    },
    "Chief Yamarz": {
      "base_facts": [
        "I am the chief of Largashbur, though Malacath considers me weak.",
        "Giants have desecrated Malacath's shrine and I must reclaim it."
      ],
      "beat_facts": {
        "ESCORT_YAMARZ": [
          "I am traveling to Fallowstone Cave to deal with the giant."
        ],
        "DEFEAT_GIANT": [
          "The giant at the shrine has been defeated."
        ]
      }
    },
    "Gularzob": {
      "base_facts": [
        "I am an Orc of Largashbur."
      ],
      "beat_facts": {
        "QUEST_COMPLETE": [
          "Malacath has named me the new chief of Largashbur."
        ]
      }
    }
  },
