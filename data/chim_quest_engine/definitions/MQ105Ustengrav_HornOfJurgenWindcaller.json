    "quest_editor_id":  "MQ105Ustengrav",
    "title":  "The Horn of Jurgen Windcaller",
    "description":  "Arngeir sends the Dragonborn on a final trial to retrieve the Horn of Jurgen Windcaller from Ustengrav. Upon arrival the Horn is missing, replaced by a note from Delphine requesting a meeting at the Sleeping Giant Inn in Riverwood. After meeting Delphine and recovering the Horn, the Dragonborn returns to High Hrothgar, learns the final word of Unrelenting Force from Wulfgar, and receives the Greybeards\u0027 formal recognition as Dragonborn.",
    "npc_facts":  {
                      "Arngeir":  {
                                      "base_facts":  [
                                                         "I am the eldest of the Greybeards and speak for our order.",
                                                         "I have sent the Dragonborn to retrieve the Horn of Jurgen Windcaller from Ustengrav as a final trial.",
                                                         "The Horn is named after Jurgen Windcaller, the founder of the Greybeards."
                                                     ],
                                      "beat_facts":  {
                                                         "RETURN_HORN":  [
                                                                             "The Dragonborn has returned with the Horn and proven worthy of the trial."
                                                                         ],
                                                         "QUEST_COMPLETE":  [
                                                                                "The Greybeards have formally recognized the Dragonborn. High Hrothgar is now open to them."
                                                                            ]
                                                     }
                                  },
                      "Wulfgar":  {
                                      "base_facts":  [
                                                         "I am one of the Greybeards.",
                                                         "I will teach the final word of Unrelenting Force once the Dragonborn completes their trial."
                                                     ],
                                      "beat_facts":  {
                                                         "GREYBEARDS_RECOGNITION":  [
                                                                                        "I have taught the Dragonborn the final word of Unrelenting Force."
                                                                                    ]
                                                     }
                                  },
                      "Delphine":  {
                                       "base_facts":  [
                                                          "I run the Sleeping Giant Inn in Riverwood.",
                                                          "I took the Horn of Jurgen Windcaller from Ustengrav to get the Dragonborn\u0027s attention."
                                                      ],
                                       "beat_facts":  {
                                                          "MEET_DELPHINE":  [
                                                                                "I have revealed myself to the Dragonborn and returned the Horn.",
                                                                                "My organization has been looking for someone like the Dragonborn."
                                                                            ]
                                                      }
                                   }
                  },
