  "quest_editor_id": "MS07",
  "title": "Lights Out!",
  "description": "Jaree-Ra on the Solitude docks offers a scheme to extinguish the lighthouse fire and plunder a wrecked ship, but the Argonian siblings betray you and you must fight through the Blackblood Marauders to survive.",
  "npc_facts": {
    "Jaree-Ra": {
      "base_facts": [
        "I am an Argonian at the Solitude docks with a profitable offer.",
        "I want someone to put out the Solitude Lighthouse fire so the Icerunner crashes on the rocks.",
        "I promised the crew would not be harmed and there would be a share of the plunder.",
        "I plan to betray my partner and keep all the loot at Broken Oar Grotto."
      ],
      "beat_facts": {
        "JAREE_RA_OFFER": [
          "I have recruited someone to extinguish the lighthouse beacon. I told them to meet me at the docks afterward."
        ],
        "RETURN_TO_JAREE_RA": [
          "The lighthouse fire is out and the Icerunner never made it to port. I sent my partner to find Deeja at the wreck."
        ],
        "HUNT_JAREE_RA": [
          "My sister Deeja is dead and my partner knows I betrayed them. I am at Broken Oar Grotto with the loot."
        ],
        "QUEST_COMPLETE": [
          "Quest complete after defeating Jaree-Ra and his bandits.",
          "Speak to him, and he asks how you would like making some gold.",
          "Make your way to Deeja, kill her, and loot the note from Jaree-Ra that will start the next part of the quest."
        ]
      }
    },
    "Deeja": {
      "base_facts": [
        "I am Jaree-Ra's sister and a Blackblood Marauder.",
        "I am waiting at the Wreck of the Icerunner for Jaree-Ra's partner.",
        "I have no intention of sharing the plunder. I will kill them once they arrive."
      ],
      "beat_facts": {
        "DEEJA_BETRAYAL_AND_DEFEAT": [
          "My partner has arrived at the wreck. The plunder has already been moved. Time to dispose of them."
        ]
      }
    }
  },
