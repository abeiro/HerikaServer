  "quest_editor_id": "TGLarceny",
  "title": "The Litany of Larceny",
  "description": "A Thieves Guild side quest to find and return seven unique larceny items to Delvin Mallory at the Ragged Flagon for leveled gold rewards. Each item is discovered during the main Guild questline.",
  "npc_facts": {
    "Delvin Mallory": {
      "base_facts": [
        "I am a member of the Thieves Guild operating out of the Ragged Flagon.",
        "I purchase special items of interest to the Guild for a fair price.",
        "I value unique trinkets connected to the Guild's history and operations."
      ],
      "beat_facts": {
        "DISCOVER_QUEEN_BEE_STATUE": [
          "The Queen Bee Statue from Goldenglow Estate is one of the larceny items I want."
        ],
        "DISCOVER_HONNINGBREW_DECANTER": [
          "The Honningbrew Decanter from Honningbrew Meadery is one of the larceny items I want."
        ],
        "DISCOVER_EAST_EMPIRE_MAP": [
          "The East Empire Shipping Map from the Warehouse is one of the larceny items I want."
        ],
        "DISCOVER_MODEL_SHIP": [
          "The Model Ship from Snow Veil Sanctum is one of the larceny items I want."
        ],
        "DISCOVER_DWEMER_PUZZLE_CUBE": [
          "The Dwemer Puzzle Cube from Calcelmo's Laboratory is one of the larceny items I want."
        ],
        "DISCOVER_BUST_OF_GRAY_FOX": [
          "The Bust of the Gray Fox from Riftweald Manor is one of the larceny items I want."
        ],
        "DISCOVER_LEFT_EYE_OF_FALMER": [
          "The Left Eye of the Falmer from Irkngthand is one of the larceny items I want.",
          "Player finds the Left Eye of the Falmer at Irkngthand Sanctuary during Blindsighted.",
          "Reward [ edit ] This is the amount of gold you get each time you turn in an item, except the eye with four times higher reward.",
          "Picking them up will add a miscellaneous task to take it to Delvin Mallory , who will pay a leveled amount of money for the item."
        ]
      }
    }
  },
