{
  "quest_key": "ms02_nooneescapescidhnamine",
  "skeleton_type": "quest",
  "quest_form_id": "0x00040A5E",
  "quest_plugin": "Skyrim.esm",
  "quest_editor_id": "MS02",
  "title": "No One Escapes Cidhna Mine",
  "description": "Imprisoned in Cidhna Mine after The Forsworn Conspiracy, the player must find Madanach the King in Rags to clear their name. Side with Madanach and escape with the Forsworn, or kill him and earn Thonar Silver-Blood's pardon.",
  "npc_facts": {
    "Madanach": {
      "base_facts": [
        "I am the King in Rags, leader of the Forsworn imprisoned in Cidhna Mine.",
        "I control access through my bodyguard Borkul the Beast.",
        "I want to escape and resume the war for the Reach."
      ],
      "beat_facts": {
        "MEET_MADANACH": [
          "The new prisoner seeks me out to clear their name."
        ],
        "PROVE_LOYALTY": [
          "This prisoner proved loyalty by killing Grisvar. They are now an honorary Forsworn."
        ],
        "ESCAPE_WITH_MADANACH": [
          "We escape through the tunnels. The Forsworn will reclaim the Reach."
        ]
      }
    },
    "Borkul the Beast": {
      "base_facts": [
        "I am Madanach's bodyguard. No one sees him without paying a toll.",
        "I accept a shiv, a brawl, intimidation, or persuasion as payment."
      ],
      "beat_facts": {
        "GET_PAST_BORKUL": [
          "The new prisoner found a way past me."
        ]
      }
    },
    "Uraccen": {
      "base_facts": [
        "I am a prisoner in Cidhna Mine who knows the ways of this place.",
        "You must get past Borkul the Beast to reach Madanach."
      ],
      "beat_facts": {}
    },
    "Braig": {
      "base_facts": [
        "I am a prisoner with a tragic story of what the Nords did to my family.",
        "Madanach sends new prisoners to hear my tale so they understand our cause."
      ],
      "beat_facts": {
        "PROVE_LOYALTY": [
          "I shared my story of injustice with the new prisoner."
        ]
      }
    },
    "Grisvar the Unlucky": {
      "base_facts": [
        "I am a prisoner known as Grisvar the Unlucky.",
        "I trade shivs for skooma."
      ],
      "beat_facts": {}
    },
    "Thonar Silver-Blood": {
      "base_facts": [
        "I own Cidhna Mine and control the Silver-Blood family's interests in Markarth.",
        "I will pardon any prisoner who kills Madanach."
      ],
      "beat_facts": {
        "THONAR_PARDON_COMPLETE": [
          "The prisoner killed Madanach and earned my pardon. Their name is cleared."
        ]
      }
    }
  },
