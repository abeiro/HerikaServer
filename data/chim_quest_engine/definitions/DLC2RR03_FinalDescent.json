                                                                                      ],
                                                                     "FIND_JOURNAL":  [
                                                                                          "They found Gratian\u0027s journal deep in the mine."
                                                                                      ],
                                                                     "COMPLETE_QUEST":  [
                                                                                            "The truth about Gratian\u0027s death has finally been uncovered."
                                                                                        ]
                                                                 }
                                              },
                      "Aphia Velothi":  {
                                            "base_facts":  [
                                                               "I am Crescius\u0027s wife and I worry about him exploring the dangerous mine.",
