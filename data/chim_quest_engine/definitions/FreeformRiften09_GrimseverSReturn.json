  "title": "Grimsever's Return",
  "description": "Mjoll the Lioness lost her prized blade Grimsever in the Dwemer ruins of Mzinchaleft. Retrieve it and return it to her to earn her loyalty as a follower.",
  "natural_start": {
    "enabled": true,
    "beats": [
      "HEAR_ABOUT_GRIMSEVER",
      "OFFER_TO_HELP"
    ],
    "requires": []
  },
  "npc_facts": {
    "Mjoll the Lioness": {
      "base_facts": [
        "I lost my sword Grimsever in the Dwemer ruin of Mzinchaleft.",
        "I feel defenseless without my blade and have not found a worthy replacement.",
        "I used to adventure across Tamriel before nearly dying in Mzinchaleft.",
        "I speak out against the Thieves Guild here in Riften."
      ],
      "beat_facts": {
        "HEAR_ABOUT_GRIMSEVER": [
          "Someone has heard about my lost blade Grimsever."
        ],
        "OFFER_TO_HELP": [
          "Someone has offered to retrieve Grimsever for me, though it may be a fool's errand."
        ],
        "COMPLETE_QUEST": [
          "Grimsever is back in my hands. I am astonished someone actually reached it and survived — their skill rivals any I've encountered in my travels.",
          "I have offered to accompany this person as a follower, honored by their prowess and admitting I still have much to learn.",
          "If this person spoke of joining the Thieves Guild, I have reconsidered my hasty opinion of them — they returned my blade when they could have easily sold or kept it.",
          "I am now willing to travel with this person as a companion and would consider marriage as well."
        ]
      }
    }
  },
