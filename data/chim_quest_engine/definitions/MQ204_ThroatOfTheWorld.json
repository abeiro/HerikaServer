    "title":  "The Throat of the World",
    "description":  "After deciphering Alduin\u0027s Wall, the Dragonborn learns that Alduin was defeated by a Shout called Dragonrend. Arngeir cannot teach it but directs the Dragonborn to Paarthurnax at the summit of the Throat of the World. After learning Clear Skies to bypass the magical winds, the Dragonborn meets Paarthurnaxâ€”who reveals he does not know Dragonrend either, but believes it can be learned from the ancient heroes through an Elder Scroll at the Time-Wound.",
    "npc_facts":  {
                      "Arngeir":  {
                                      "base_facts":  [
                                                         "I am the foremost of the Greybeards and speak for our order.",
                                                         "The Shout used to defeat Alduin is called Dragonrend, but I do not know it and its origins are lost to us.",
                                                         "Only Paarthurnax, our leader who dwells at the summit of the Throat of the World, may know Dragonrend.",
                                                         "I can teach you the Clear Skies Shout to clear the path through the magical winds blocking the way to the summit."
                                                     ],
                                      "beat_facts":  {
                                                         "SEEK_ARNGEIR":  [
                                                                              "The Dragonborn has come seeking knowledge of the Shout that defeated Alduin. I will help them reach Paarthurnax."
                                                                          ],
                                                         "LEARN_CLEAR_SKIES":  [
                                                                                   "I have taught the Dragonborn all three words of Clear Skies so they may ascend to the Throat of the World."
                                                                               ]
                                                     }
                                  },
                      "Paarthurnax":  {
                                          "base_facts":  [
                                                             "I am Paarthurnax, leader of the Greybeards and a dragon who has chosen the Way of the Voice.",
                                                             "I have lived in seclusion at the summit of the Throat of the World for thousands of years.",
                                                             "I do not know the Dragonrend Shout, as it was created by mortals to defy dragons."
                                                         ],
                                          "beat_facts":  {
                                                             "REACH_PAARTHURNAX":  [
                                                                                       "The Dragonborn has reached my mountain. We must observe the formalities of the dov before we speak."
                                                                                   ],
                                                             "LEARN_FIRE_BREATH":  [
                                                                                       "I have shared the Word Yolâ€”Fireâ€”with the Dragonborn as a gift of understanding between dov."
                                                                                   ],
                                                             "QUEST_COMPLETE":  [
                                                                                    "The Dragonrend Shout can be learned by looking back through the Time-Wound using an Elder Scroll. The ancient Tongues who used it against Alduin can teach it."
                                                                                ]
                                                         }
                                      }
                  },
