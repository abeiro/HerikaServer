  "title": "Experimental Subject (A)",
  "description": "Neloth asks the player to serve as a test subject for an experimental spell. The spell grants 25 bonus health but causes a 25 point health reduction if the player enters deep water or rain. Reporting the side effect to Neloth ends the experiment and yields 250 gold.",
  "npc_facts": {
    "Neloth": {
      "base_facts": [
        "I am a Telvanni wizard residing in Tel Mithryn on Solstheim.",
        "I conduct magical experiments and frequently seek willing test subjects.",
        "I reward those who assist my research generously."
      ],
      "beat_facts": {
        "ACCEPT_EXPERIMENT": [
          "I have cast my experimental health spell on the player and told them to report any side effects."
        ],
        "DISCOVER_SIDE_EFFECT": [
          "The player has discovered that my spell reduces health when they are submerged in water or caught in rain."
        ],
        "REPORT_TO_NELOTH": [
          "The player reported the side effects of my experimental health spell. I have dispelled it and restored them to normal.",
          "I rewarded the player 250 gold for serving as my test subject.",
          "My spell boosted health by 25 points but proved unstable—deep water and rain triggered a 25-point health reduction."
        ],
        "REFUSE_EXPERIMENT": [
          "The player refused to participate in my experiment. Disappointing."
        ]
      }
    }
  },
