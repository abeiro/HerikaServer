                      "Astrid":  {
                                     "base_facts":  [
                                                        "I lead the Dark Brotherhood sanctuary.",
                                                        "We have a scheme to impersonate the Gourmet and poison the Emperor\u0027s meal.",
                                                        "Festus Krex is directing this phase of the operation."
                                                    ],
                                     "beat_facts":  {

                                                    }
                                 },
                      "Festus Krex":  {
                                          "base_facts":  [
                                                             "I am a senior member of the Dark Brotherhood.",
                                                             "The Gourmet\u0027s true identity is known by very few.",
                                                             "Anton Virane owns an autographed copy of Uncommon Taste and may know who the Gourmet really is."
                                                         ],
                                          "beat_facts":  {
                                                             "REPORT_TO_FESTUS":  [
                                                                                      "Your target is the Gourmet. Kill him and take his identity so we can poison the Emperor\u0027s meal."
                                                                                  ],
                                                             "REPORT_TO_FESTUS_FINAL":  [
                                                                                            "The Gourmet is dead and we have the Writ of Passage. The plan to move against the Emperor proceeds."
                                                                                        ]
                                                         }
                                      },
                      "Anton Virane":  {
                                           "base_facts":  [
                                                              "I work in the Understone Keep kitchen in Markarth.",
                                                              "I own an autographed copy of Uncommon Taste.",
                                                              "I know the Gourmet\u0027s true identity."
                                                          ],
                                           "beat_facts":  {
                                                              "QUESTION_ANTON_VIRANE":  [
                                                                                            "The Gourmet is an Orc named Balagog gro-Nolob.",
                                                                                            "Balagog gro-Nolob can be found at the Nightgate Inn."
                                                                                        ]
                                                          }
                                       },
