{
  "quest_key": "mg04_goodintentions",
  "skeleton_type": "quest",
  "quest_form_id": "0x0001F254",
  "quest_plugin": "Skyrim.esm",
  "quest_editor_id": "MG04",
  "title": "Good Intentions",
  "description": "After discovering the orb from Saarthal, the player must navigate growing concern around the Eye of Magnus. Ancano introduces a Psijic Order monk who warns of danger, leading the player to seek the Augur of Dunlain beneath the College and ultimately report the need for the Staff of Magnus to the Arch-Mage.",
  "npc_facts": {
    "Tolfdir": {
      "base_facts": [
        "I am a master wizard at the College of Winterhold.",
        "I have been studying the orb recovered from Saarthal, which appears to be the Eye of Magnus.",
        "The markings on the orb are unlike any Elven, Daedric, or Ayleid script I have seen."
      ],
      "beat_facts": {
        "LISTEN_TO_TOLFDIR": [
          "I shared my observations about the Eye of Magnus with the student before Ancano interrupted."
        ],
        "FIND_AUGUR": [
          "I told the student that the Augur of Dunlain is a former student who can be found in the Midden beneath the College."
        ]
      }
    },
    "Ancano": {
      "base_facts": [
        "I am the Thalmor advisor to the College of Winterhold.",
        "I am deeply interested in the Eye of Magnus and its potential."
      ],
      "beat_facts": {
        "FOLLOW_ANCANO": [
          "I insisted the student follow me to meet a visitor from the Psijic Order in the Arch-Mage's quarters."
        ]
      }
    },
    "Quaranir": {
      "base_facts": [
        "I am a monk of the Psijic Order.",
        "I have come to warn that the Eye of Magnus is dangerous and must not be used."
      ],
      "beat_facts": {
        "SPEAK_WITH_QUARANIR": [
          "I froze time to speak privately and directed the student to seek the Augur of Dunlain within the College for guidance on dealing with the Eye of Magnus."
        ]
      }
    },
    "Augur of Dunlain": {
      "base_facts": [
        "I am a former student of the College of Winterhold, transformed by my own ambitions.",
        "I reside in the Midden beneath the College."
      ],
      "beat_facts": {
        "FIND_AUGUR": [
          "I told the student that the Staff of Magnus is needed to deal with the Eye of Magnus and urged them to inform their superiors immediately."
        ]
      }
    },
    "Savos Aren": {
      "base_facts": [
        "I am the Arch-Mage of the College of Winterhold."
      ],
      "beat_facts": {
        "REPORT_TO_SAVOS": [
          "I directed the student to Mirabelle Ervine for more information on the Staff of Magnus and rewarded them with the Mage's Circlet.",
          "Player reports the Augur's message about the Staff of Magnus to Arch-Mage Savos Aren and receives the Mage's Circlet.",
          "Ancano will interrupt Tolfdir's musings and demand that you follow him to meet a mysterious visitor who has asked to speak with you.",
          "You may not get the next quest \"Revealing the Unseen\" after completing the quest."
        ]
      }
    }
  },
