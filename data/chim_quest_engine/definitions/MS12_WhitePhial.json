  "quest_editor_id": "MS12",
  "title": "The White Phial",
  "description": "Nurelion, an elderly and dying alchemist in Windhelm, asks the player to retrieve the legendary White Phial from Forsaken Cave, where it is buried with its maker Curalmil. The Phial turns out to be cracked and useless, devastating Nurelion. His assistant Quintus Navale provides the true reward of 500 gold.",
  "npc_facts": {
    "Nurelion": {
      "base_facts": [
        "I am an old and sick alchemist who owns The White Phial shop in Windhelm.",
        "I have spent my entire life searching for the legendary White Phial.",
        "The White Phial is buried with its maker Curalmil in Forsaken Cave to the west.",
        "I have prepared a mixture to bypass Curalmil's alchemical protections in his tomb."
      ],
      "beat_facts": {
        "NURELION_REQUEST": [
          "I have sent an adventurer to retrieve the White Phial from Forsaken Cave."
        ],
        "RETURN_TO_NURELION": [
          "The White Phial was cracked and cannot hold liquid. I am devastated and have given up hope."
        ]
      }
    },
    "Quintus Navale": {
      "base_facts": [
        "I am Nurelion's assistant at The White Phial shop in Windhelm.",
        "My master is far too ill to undertake any journey himself."
      ],
      "beat_facts": {
        "QUEST_COMPLETE": [
          "I paid the adventurer 500 gold for their help, since my master only gave them 5 gold.",
          "Quintus thanks the player and pays 500 gold as proper compensation after Nurelion's meager reward.",
          "Go back to the chamber with the word wall and turn right, where you will find an open set of iron doors leading to a staircase which will return you to Forsaken Cave .",
          "As you enter the next room, activate the lever which will open the cavern wall and continue forward until you reach the tunnel leading back to Skyrim."
        ]
      }
    }
  },
