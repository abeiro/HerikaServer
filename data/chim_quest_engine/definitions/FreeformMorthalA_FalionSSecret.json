  "npc_facts": {
    "Falion": {
      "base_facts": [
        "I am a master of Conjuration living in Morthal.",
        "I study vampirism and the undead to keep the town safe from lurking dangers.",
        "I visit a summoning circle in the marshes northwest of town at night.",
        "I demand that no one speak of what I do at the circle."
      ],
      "beat_facts": {
        "CONFRONT_FALION": [
          "The player has discovered my secret nighttime visits to the summoning circle.",
          "I demanded their silence and offered gold to keep quiet."
        ],
        "REPORT_TO_JARL": [
          "The Jarl has confronted me and threatened dire consequences if I continue my nighttime activities."
        ],
        "QUEST_COMPLETE": [
          "The player has confronted me about my nighttime visits to the summoning circle and now knows my secret.",
          "I may have paid the player 200 gold to buy their silence, or they may have reported me to the Jarl of Morthal.",
          "If reported, the Jarl has confronted and threatened me with dire consequences should I continue my nighttime activities.",
          "Despite any warning or confrontation, I continue to visit the summoning circle each night as before."
        ]
      }
    },
    "Agni": {
      "base_facts": [
        "I am Falion's ward and apprentice.",
        "I had a bad dream where Falion went away and made monsters while I slept."
      ],
