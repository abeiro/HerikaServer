  "title": "The Pursuit",
  "description": "Karliah seeks to prove her innocence and expose Mercer Frey's betrayal of the Thieves Guild. After the Guild's vault is found empty, the player must infiltrate Mercer's home at Riftweald Manor to find evidence of his whereabouts.",
  "npc_facts": {
    "Karliah": {
      "base_facts": [
        "A former Thieves Guild member framed by Mercer Frey for Gallus's murder.",
        "Carries the translated journal as proof of her innocence."
      ],
      "beat_facts": {
        "MEET_KARLIAH": [
          "Presented Gallus's translated journal to the Guild as proof of her innocence."
        ],
        "CONVINCE_BRYNJOLF": [
          "Led the Guild to the empty vault, proving Mercer drained it."
        ],
        "QUEST_COMPLETE": [
          "Her innocence has been accepted by the Guild; she is no longer treated as Gallus's murderer.",
          "Stands vindicated and ready to assist in the next phase against Mercer."
        ]
      }
    },
    "Brynjolf": {
      "base_facts": [
        "Second-in-command of the Thieves Guild.",
        "Initially loyal to Mercer Frey as Guildmaster."
      ],
      "beat_facts": {
        "CONVINCE_BRYNJOLF": [
          "Convinced of Mercer's betrayal after finding the vault empty.",
          "Instructed the player to infiltrate Mercer's home for clues."
        ],
        "RETURN_PLANS": [
          "Believes Mercer intends to steal the Eyes of the Falmer before fleeing Skyrim."
        ],
        "QUEST_COMPLETE": [
          "Received Mercer's plans from the player confirming Mercer intends to steal the Eyes of the Falmer before fleeing Skyrim for good.",
          "Convinced the Guild must proceed to the gems' location immediately to intercept Mercer.",
          "Disposition toward the player has increased from 0 to 1.",
          "The pursuit of Mercer continues; Trinity Restored follows."
        ]
      }
    },
    "Vald": {
      "base_facts": [
        "A Nord guarding Riftweald Manor for Mercer Frey.",
        "Owes a debt to Maven Black-Briar that keeps him bound to the job."
      ],
      "beat_facts": {}
    },
    "Vex": {
      "base_facts": [
        "Thieves Guild member once acquainted with Vald.",
        "Suggests erasing Vald's debt with Maven or killing him to gain entry."
      ],
      "beat_facts": {}
    }
  },
