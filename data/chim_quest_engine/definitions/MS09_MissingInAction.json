    "title":  "Missing In Action",
    "description":  "Fralia Gray-Mane believes her missing son Thorald is still alive and held captive. The player must find proof of his fate from the Battle-Born family, then rescue Thorald from Thalmor custody at Northwatch Keep and deliver his message to Fralia.",
    "npc_facts":  {
                      "Fralia Gray-Mane":  {
                                               "base_facts":  [
                                                                  "I believe my son Thorald is still alive, not dead as the Battle-Borns claim.",
                                                                  "I argued with Idolaf and Olfrid Battle-Born in the market about Thorald\u0027s fate.",
                                                                  "It is not safe to discuss Thorald in the open; I asked the player to meet me at my home."
                                                              ],
                                               "beat_facts":  {
                                                                  "LEARN_OF_THORALD":  [
                                                                                           "The player has come to my home to discuss Thorald privately."
                                                                                       ],
                                                                  "RETURN_TO_FRALIA":  [
                                                                                           "The player delivered Thorald\u0027s secret message. I know my son lives and can find peace in that."
                                                                                       ]
                                                              }
                                           },
                      "Avulstein Gray-Mane":  {
                                                  "base_facts":  [
                                                                     "I am hiding in House Gray-Mane because the Imperials would arrest me if found.",
                                                                     "I know Thorald is not dead. The Battle-Borns have proof of what happened to him.",
                                                                     "I need someone to search the Battle-Born house for evidence since I cannot leave."
                                                                 ],
                                                  "beat_facts":  {
                                                                     "DELIVER_PROOF":  [
                                                                                           "The player brought me proof that Thorald is alive at Northwatch Keep."
                                                                                       ],
                                                                     "RESCUE_THORALD":  [
                                                                                            "The player has gone to Northwatch Keep to rescue Thorald."
                                                                                        ]
                                                                 }
                                              },
                      "Thorald Gray-Mane":  {
                                                "base_facts":  [
                                                                   "I am a Stormcloak supporter captured by the Thalmor and held at Northwatch Keep.",
                                                                   "I cannot return to Whiterun; it is too dangerous for my family."
                                                               ],
                                                "beat_facts":  {
                                                                   "RESCUE_THORALD":  [
                                                                                          "The player freed me from Northwatch Keep. I asked them to tell my mother: \u0027Suffer the winter\u0027s cold wind, for it bears aloft next summer\u0027s seeds.\u0027"
                                                                                      ]
                                                               }
                                            },
                      "Idolaf Battle-Born":  {
                                                 "base_facts":  [
                                                                    "Our families were once friends, but the civil war set the Gray-Manes and Battle-Borns against each other.",
                                                                    "Thorald chose the Stormcloak side and that was his mistake."
                                                                ],
                                                 "beat_facts":  {

                                                                }
                                             }
                  },
