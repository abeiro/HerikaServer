    "title":  "Dampened Spirits",
    "description":  "Brynjolf sends the player to Maven Black-Briar, who tasks them with sabotaging the Honningbrew Meadery to eliminate a competitor. Working with Mallus Maccius, the player must poison Sabjorn\u0027s mead during a tasting ceremony, get him arrested, and uncover his silent partner to protect the Thieves Guild.",
    "npc_facts":  {
                      "Brynjolf":  {
                                       "base_facts":  [
                                                          "I sent the new Guild member to Maven Black-Briar for an important job.",
                                                          "The symbol on the promissory note matches the one from Goldenglow Estate â€” someone is trying to drive a wedge between Maven and the Guild."
                                                      ],
                                       "beat_facts":  {
                                                          "RETURN_TO_BRYNJOLF":  [
                                                                                     "The same symbol links Honningbrew and Goldenglow â€” someone is trying to destroy the Guild economically. I sent them to Mercer."
                                                                                 ],
                                                          "QUEST_COMPLETE":  [
                                                                                 "The silent partner behind Honningbrew and Goldenglow is trying to destroy the Guild. I\u0027ve sent the recruit to Mercer Frey to continue the investigation."
                                                                             ]
                                                      }
                                   },
                      "Maven Black-Briar":  {
                                                "base_facts":  [
                                                                   "I am the head of the Black-Briar family and the most influential person in Riften.",
                                                                   "I want Honningbrew Meadery put out of business â€” they are my competitor.",
                                                                   "I need to know how Sabjorn funded his operation so quickly."
                                                               ],
                                                "beat_facts":  {
                                                                   "MEET_MAVEN":  [
                                                                                      "I\u0027ve sent this Guild member to Whiterun to meet Mallus Maccius and sabotage Honningbrew Meadery."
                                                                                  ],
                                                                   "REPORT_TO_MAVEN":  [
                                                                                           "The promissory note\u0027s author uses the same symbol as the Goldenglow bill of sale. I paid the Guild member with an enchanted weapon for their work."
                                                                                       ]
                                                               }
                                            },
                      "Mallus Maccius":  {
                                             "base_facts":  [
                                                                "I work at Honningbrew Meadery but I\u0027m trapped in debt to Sabjorn.",
                                                                "Maven promised me control of the meadery once Sabjorn is out of the way."
                                                            ],
                                             "beat_facts":  {
                                                                "MEET_MALLUS":  [
                                                                                    "I explained the plan: approach Sabjorn about the pest problem, use his own poison to taint the mead for the tasting ceremony."
                                                                                ],
                                                                "SABJORN_ARRESTED":  [
                                                                                         "Sabjorn is gone and I\u0027m in charge of Honningbrew now. I gave the Guild member the key to Sabjorn\u0027s dresser to find the proof Maven needs."
                                                                                     ],
                                                                "SILENT_PARTNER":  [
                                                                                       "The promissory note from Sabjorn\u0027s dresser reveals who funded the meadery operation."
                                                                                   ]
                                                            }
                                         },
                      "Sabjorn":  {
                                      "base_facts":  [
                                                         "I own Honningbrew Meadery.",
                                                         "I have a pest problem in the tunnels beneath the meadery.",
                                                         "I trapped Mallus Maccius in debt to get free labor from him."
                                                     ],
                                      "beat_facts":  {
                                                         "SABOTAGE_PLAN":  [
                                                                               "I gave the pest poison and the meadery key to someone offering to help with the infestation."
                                                                           ]
                                                     }
                                  }
