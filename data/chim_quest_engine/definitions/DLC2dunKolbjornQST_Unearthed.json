  "title": "Unearthed",
  "description": "Fund Ralis Sedarys' excavation of Kolbjorn Barrow on Solstheim, clearing draugr across multiple visits before discovering Ralis has been sacrificing miners to release the Dragon Priest Ahzidal.",
  "npc_facts": {
    "Ralis Sedarys": {
      "base_facts": [
        "I am a Dunmer treasure hunter who came to Solstheim seeking the Relics of Ahzidal.",
        "I found Kolbjorn Barrow buried in ash and need funding to excavate it.",
        "I offer a share of any treasure discovered in exchange for gold."
      ],
      "beat_facts": {
        "MEET_RALIS": [
          "A partner has agreed to fund the excavation of Kolbjorn Barrow with one thousand gold."
        ],
        "FIRST_EXCAVATION": [
          "The draugr awoke and killed my miners. My partner cleared them out and found a way deeper into the barrow."
        ],
        "SECOND_EXCAVATION": [
          "More draugr attacked and miners went missing. My partner found their bodies but the work must continue."
        ],
        "THIRD_EXCAVATION": [
          "Yet more draugr killed the mercenaries I hired. I need more gold for increasingly reluctant workers.",
          "Player returns a third time, clears more draugr after mercenaries are killed.",
          "Speak to Ralis, fund 3,000 gold to his excavation, and await another message.",
          "Speak to Ralis, fund 5,000 gold to his excavation, and await another message."
        ],
        "BETRAYAL_REVEALED": [
          "I was under Ahzidal's spell, compelled to use the miners as blood sacrifices for the ritual to release him."
        ],
        "RALIS_FATE": [
          "I have been confronted about my actions. I claim I had no control over what I did under Ahzidal's influence."
        ]
      }
    }
  },
