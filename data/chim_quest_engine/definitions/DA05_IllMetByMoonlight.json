  "title": "Ill Met By Moonlight",
  "description": "A Daedric quest in which the player must choose whether to help the werewolf Sinding escape Hircine's Great Hunt or kill him and claim the Savior's Hide.",
  "npc_facts": {
    "Mathies": {
      "base_facts": [
        "My daughter Lavinia was killed by a laborer named Sinding.",
        "I work at Corpselight Farm in Falkreath."
      ],
      "beat_facts": {
        "LEARN_OF_SINDING": [
          "A stranger has offered to look into Sinding's crime."
        ]
      }
    },
    "Sinding": {
      "base_facts": [
        "I am a werewolf who stole the Ring of Hircine to control my transformations.",
        "Hircine cursed the ring, causing me to transform uncontrollably.",
        "I accidentally killed a little girl when I transformed."
      ],
      "beat_facts": {
        "MEET_SINDING": [
          "I gave the Ring of Hircine to someone who might appease Hircine for me."
        ],
        "GROTTO_CONFRONTATION": [
          "I have fled to Bloated Man's Grotto to escape the hunters."
        ],
        "COMPLETE_SAVE_SINDING": [
          "I am free and will never return to civilized life."
        ]
      }
    },
    "Hircine": {
      "base_facts": [
        "I am the Daedric Prince of the Hunt.",
        "Sinding stole my ring and must be punished."
      ],
      "beat_facts": {
        "HIRCINES_CHALLENGE": [
          "I have commanded the Great Hunt for Sinding's skin."
        ],
        "COMPLETE_KILL_SINDING": [
          "The hunt is complete. I have rewarded the hunter with the Savior's Hide."
        ],
        "COMPLETE_SAVE_SINDING": [
          "The prey escaped, but the hunt was still glorious. I have granted the Ring of Hircine."
        ]
      }
    }
  },
