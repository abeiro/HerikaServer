  "quest_editor_id": "FreeformValdDebt",
  "title": "Vald's Debt",
  "description": "Clear Vald's debt to Maven Black-Briar by retrieving the lost Quill of Gemination from the bottom of Lake Honrich, so Vald will stop guarding Riftweald Manor for Mercer Frey.",
  "npc_facts": {
    "Maven Black-Briar": {
      "base_facts": [
        "I commissioned a unique quill from Winterhold years ago.",
        "Vald was supposed to deliver it but lost it at the bottom of Lake Honrich.",
        "Vald owes me a debt."
      ],
      "beat_facts": {
        "TALK_TO_MAVEN": [
          "I told someone about the Quill of Gemination lost in Lake Honrich."
        ],
        "RETURN_QUILL": [
          "The Quill has been returned to me. I wrote a note clearing Vald's debt."
        ]
      }
    },
    "Vald": {
      "base_facts": [
        "I owe Maven Black-Briar a debt.",
        "I guard Riftweald Manor for Mercer Frey because of my debt to Maven."
      ],
      "beat_facts": {
        "QUEST_COMPLETE": [
          "My debt to Maven has been cleared. I gave the key to Riftweald Manor and opened the back gate.",
          "Player gives Vald the note from Maven clearing his debt. Vald provides the key to Riftweald Manor.",
          "Attempting to erase Vald's debt after he is dead will still earn you leveled gold, but you will be unable to complete the quest by delivering the letter of pardon.",
          "To do this, talk to Maven to get the quill to spawn, go and obtain the quill, then go to Vald and intimidate/bribe him to let you pass."
        ]
      }
    }
  },
