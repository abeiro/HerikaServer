  "quest_editor_id": "MQ104",
  "title": "Dragon Rising",
  "description": "After returning the Dragonstone to Farengar, a dragon is sighted near Whiterun. Jarl Balgruuf sends the player with Irileth to investigate the Western Watchtower, where they slay the dragon Mirmulnir and absorb its soul, revealing the player as Dragonborn. The Jarl rewards the player with the Thaneship of Whiterun and the housecarl Lydia.",
  "npc_facts": {
    "Farengar Secret-Fire": {
      "base_facts": [
        "Court wizard of Whiterun residing in Dragonsreach.",
        "Studies dragons and their lore.",
        "Requested the Dragonstone from Bleak Falls Barrow."
      ],
      "beat_facts": {
        "REPORT_DRAGONSTONE": [
          "The Dragonstone has been recovered from Bleak Falls Barrow."
        ],
        "DRAGON_SIGHTED": [
          "A dragon has been sighted near the Western Watchtower outside Whiterun."
        ]
      }
    },
    "Jarl Balgruuf": {
      "base_facts": [
        "Jarl of Whiterun Hold, rules from Dragonsreach.",
        "Concerned about the dragon threat and the civil war's pressure on his hold."
      ],
      "beat_facts": {
        "REPORT_DRAGONSTONE": [
          "The Dragonstone has been returned; the hero deserves a reward."
        ],
        "DRAGON_SIGHTED": [
          "A dragon was sighted at the Western Watchtower; sending Irileth and the hero to investigate."
        ],
        "ABSORB_SOUL_REPORT": [
          "This person is Dragonborn; the Greybeards are summoning them to High Hrothgar."
        ],
        "THANE_OF_WHITERUN": [
          "Appointed the Dragonborn as Thane of Whiterun and granted Lydia as housecarl."
        ]
      }
    },
    "Irileth": {
      "base_facts": [
        "Housecarl to Jarl Balgruuf, a fiercely loyal Dunmer warrior.",
        "Commands the Whiterun Guard when directed by the Jarl."
      ],
      "beat_facts": {
        "DEPLOY_TO_WATCHTOWER": [
          "Leading the expedition to the Western Watchtower to confront the dragon."
        ],
        "KILL_DRAGON": [
          "The dragon Mirmulnir has been slain at the watchtower."
        ],
        "ABSORB_SOUL_REPORT": [
          "The hero absorbed the dragon's soul; some guards call them Dragonborn but Irileth dismisses it as myth."
        ]
      }
    },
    "Lydia": {
      "base_facts": [
        "A warrior of Whiterun stationed at Dragonsreach.",
        "Sworn to serve the Jarl and the Thane of Whiterun."
      ],
      "beat_facts": {
        "THANE_OF_WHITERUN": [
          "Sworn as housecarl to the new Thane of Whiterun, ready to follow and protect them."
        ]
      }
    }
  },
