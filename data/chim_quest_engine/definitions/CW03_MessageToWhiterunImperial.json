                                                   "base_facts":  [
                                                                      "I am the Jarl of Whiterun, trying to keep my hold neutral in the Civil War.",
                                                                      "I will not commit to the Empire until the dragon threat at Whiterun is dealt with."
                                                                  ],
                                                   "beat_facts":  {
                                                                      "MESSAGE_DELIVERED":  [
                                                                                                "I have received General Tullius\u0027s message but am reluctant to pick a side.",
                                                                                                "I am sending my war axe to Ulfric Stormcloak as a traditional Nord peace offering."
                                                                                            ],
                                                                      "JARL_WARNED":  [
                                                                                          "Ulfric has rejected my axe, meaning war is coming to Whiterun.",
                                                                                          "I have accepted Imperial military support to defend the city."
                                                                                      ]
                                                                  }
                                               },
                      "Ulfric Stormcloak":  {
                                                "base_facts":  [
                                                                   "I am the Jarl of Windhelm and leader of the Stormcloak rebellion.",
                                                                   "I seek to liberate Skyrim from Imperial rule."
                                                               ],
                                                "beat_facts":  {
                                                                   "AXE_DELIVERED":  [
                                                                                         "I have rejected Balgruuf\u0027s war axe, signaling that I will attack Whiterun.",
                                                                                         "I told the courier that Balgruuf should prepare to entertain visitors."
                                                                                     ]
                                                               }
                                            },
                      "Legate Quentin Cipius":  {
                                                    "base_facts":  [
                                                                       "I am the Imperial Legate stationed in Whiterun."
                                                                   ],
                                                    "beat_facts":  {
                                                                       "REPORTED_TO_LEGATE":  [
                                                                                                  "The Stormcloaks are already on the move toward Whiterun.",
                                                                                                  "The defense of Whiterun must begin immediately."
