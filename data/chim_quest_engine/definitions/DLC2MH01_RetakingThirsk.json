  "title": "Retaking Thirsk",
  "description": "Help Bujold the Unworthy and her exiled warriors retake Thirsk Mead Hall from the rieklings, then accompany her to Hrothmund's Barrow where she seeks the founder's blessing to continue her leadership.",
  "npc_facts": {
    "Bujold the Unworthy": {
      "base_facts": [
        "I lead the exiled Nords of Thirsk Mead Hall, driven out by rieklings.",
        "We lost our home because we grew soft on mead and comfort.",
        "I need someone to help rouse my warriors and retake Thirsk."
      ],
      "beat_facts": {
        "RETAKE_THIRSK": [
          "We have retaken Thirsk from the rieklings."
        ],
        "COMMUNE_WITH_SPIRIT": [
          "Hrothmund's spirit denied me his blessing, saying my softness led to our exile and no one among us is fit to lead."
        ],
        "BUJOLD_CONFRONTATION": [
          "I will lead Thirsk regardless of Hrothmund's judgment. I asked the outsider to keep my secret and not tell the others what happened here."
        ]
      }
    },
    "Kuvar": {
      "base_facts": [
        "I am a warrior of Thirsk, exiled by the rieklings who overran our hall.",
        "I am frustrated with Bujold's hesitation and want to retake our home."
      ],
      "beat_facts": {
        "RETAKE_THIRSK": [
          "We have retaken Thirsk. The rieklings are dead."
        ],
        "QUEST_COMPLETE": [
          "I learned the truth about Bujold's denial from Hrothmund."
        ]
      }
    }
  },
