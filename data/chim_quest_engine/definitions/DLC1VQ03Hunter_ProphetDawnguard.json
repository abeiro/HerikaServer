  "quest_editor_id": "DLC1VQ03Hunter",
  "title": "Prophet (Dawnguard)",
  "description": "Isran asks you to follow him to interrogate Serana, who reveals her father Harkon seeks to control the sun via an Elder Scroll prophecy. You must find a Moth Priest to read Serana's Elder Scroll, track him to Dragon Bridge and Forebears' Holdout, rescue him from vampire captors, and return him to Fort Dawnguard.",
  "npc_facts": {
    "Isran": {
      "base_facts": [
        "I lead the Dawnguard from Fort Dawnguard.",
        "I do not trust vampires, but I will use them as assets if necessary.",
        "A Moth Priest was seen on the road near the fort recently."
      ],
      "beat_facts": {
        "FOLLOW_ISRAN": [
          "I have brought Serana in for questioning about the Elder Scroll she carries."
        ],
        "LEARN_OF_PROPHECY": [
          "I have reluctantly agreed to let Serana help the Dawnguard stop Harkon."
        ],
        "REPORT_TO_ISRAN": [
          "The Moth Priest has been rescued and brought to Fort Dawnguard."
        ],
        "ELDER_SCROLL_READING": [
          "The Moth Priest's reading revealed Auriel's Bow and the need for two more Elder Scrolls."
        ]
      }
    },
    "Serana": {
      "base_facts": [
        "I am a vampire, but I oppose my father Harkon.",
        "I carry an Elder Scroll that was buried with me.",
        "My father wants to use a prophecy to control the sun."
      ],
      "beat_facts": {
        "LEARN_OF_PROPHECY": [
          "Only a Moth Priest can read an Elder Scroll.",
          "The College of Winterhold may know where to find a Moth Priest."
        ],
        "SEARCH_FOR_MOTH_PRIEST": [
          "I will accompany you to find the Moth Priest."
        ],
        "RESCUE_MOTH_PRIEST": [
          "The vampires have enthralled the Moth Priest; we must break their hold on him."
        ]
      }
    },
    "Dexion Evicus": {
      "base_facts": [
        "I am a Moth Priest of the White Gold Tower.",
        "I can read Elder Scrolls."
      ],
      "beat_facts": {
        "RESCUE_MOTH_PRIEST": [
          "I was captured and enthralled by the vampire Malkus, but you broke his hold over me.",
          "I will assist the Dawnguard by reading the Elder Scroll."
        ],
        "ELDER_SCROLL_READING": [
          "I saw a vision of Auriel's Bow in the Elder Scroll, but two more scrolls are needed to unravel the full prophecy."
        ]
      }
    }
  },
