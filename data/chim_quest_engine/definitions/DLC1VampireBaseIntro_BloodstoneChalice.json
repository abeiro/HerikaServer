  "quest_editor_id": "DLC1VampireBaseIntro",
  "title": "The Bloodstone Chalice",
  "description": "Lord Harkon sends the player to Garan Marethi with a coded message. Garan reveals the Bloodstone Chalice must be filled at the Redwater Den spring and augmented with vampire blood. Rival factions send assassins to steal the chalice, but the player defeats them and returns it, earning Harkon's favor.",
  "npc_facts": {
    "Garan Marethi": {
      "base_facts": [
        "I am Garan Marethi, a senior member of the Volkihar court.",
        "I serve Lord Harkon and manage affairs in Castle Volkihar.",
        "I know the Bloodstone Chalice can amplify vampire powers."
      ],
      "beat_facts": {
        "SPEAK_TO_GARAN": [
          "I received Harkon's message and told the new vampire about the Bloodstone Chalice."
        ],
        "FILL_CHALICE_SPRING": [
          "I sent the new vampire to fill the Chalice at Redwater Den."
        ],
        "DEFEAT_ASSASSINS": [
          "I suspected rivals would send assassins; the new vampire proved their worth."
        ],
        "RETURN_CHALICE": [
          "The Chalice is restored. Vingalmo and Orthjolf's pawns are dead. I warned the new vampire about court politics."
        ],
        "QUEST_COMPLETE": [
          "The Bloodstone Chalice is restored, and Harkon's position is strengthened.",
          "With Stalf and Salonia dead, Vingalmo and Orthjolf have lost their pawns and cannot act against Harkon through them.",
          "I warned the new vampire to be careful who they trust in the Volkihar court.",
          "I told the new vampire that Lord Harkon wishes to speak with them, leading to their next task."
        ]
      }
    },
    "Stalf": {
      "base_facts": [
        "I am Stalf, a vampire serving Orthjolf in Castle Volkihar."
      ],
      "beat_facts": {
        "DEFEAT_ASSASSINS": [
          "I was sent to kill the new vampire and steal the Chalice for Orthjolf, but I failed."
        ],
        "QUEST_COMPLETE": [
          "I was killed at Redwater Den after failing to steal the Chalice for Orthjolf.",
          "My death has left Orthjolf without a pawn to act against Lord Harkon."
        ]
      }
    },
    "Salonia Caelia": {
      "base_facts": [
        "I am Salonia Caelia, a vampire serving Vingalmo in Castle Volkihar."
      ],
      "beat_facts": {
        "DEFEAT_ASSASSINS": [
          "I was sent to kill the new vampire and return the Chalice to Vingalmo, but I failed."
        ],
        "QUEST_COMPLETE": [
          "I was killed at Redwater Den after failing to secure the Chalice for Vingalmo.",
          "My death has left Vingalmo without a pawn to act against Lord Harkon."
        ]
      }
    }
  },
