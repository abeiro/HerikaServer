  "quest_plugin": "Skyrim.esm",
  "quest_editor_id": "MS10",
  "title": "Rise in the East",
  "description": "Help the East Empire Company reopen its Windhelm office by eliminating the Blood Horker pirate base at Japhet's Folly.",
  "npc_facts": {
    "Orthus Endario": {
      "base_facts": [
        "I work for the East Empire Company in Windhelm.",
        "Pirate attacks have shut down our shipping operations.",
        "I suspect the Shatter-Shield clan is connected to the pirates.",
        "Suvaris Atheron keeps a logbook that may contain evidence of the connection."
      ],
      "beat_facts": {
        "RETURN_LOGBOOK": [
          "The logbook proves Suvaris met with Blood Horker pirates in Dawnstar."
        ],
        "INVESTIGATE_DAWNSTAR": [
          "Adelaisa Vendicci has arrived from the Company to oversee the operation."
        ],
        "COMPLETE_QUEST": [
          "Player reports to Adelaisa, returns to Windhelm, and speaks to Orthus to complete the quest.",
          "He/She should be returning any moment.\" Adelaisa : \"This must be him/her, then.\" If you talk to Orthus, he will briefly introduce Adelaisa and point you towards her; when you approach, she will be grateful to finally.",
          "Proceed up the western slope to a door, leading to Japhet Folly's Tower."
        ]
      }
    },
    "Adelaisa Vendicci": {
      "base_facts": [
        "I am a superior in the East Empire Company.",
        "I have come to Windhelm to deal with the pirate problem personally."
      ],
      "beat_facts": {
        "ASSAULT_JAPHET": [
          "We sail to Japhet's Folly to destroy the Blood Horker base.",
          "Haldyn's battlemage magic creates the fog around the island."
        ],
        "KILL_HALDYN": [
          "With Haldyn dead the fog has lifted and our ships can attack."
        ]
      }
    },
    "Stig Salt-Plank": {
      "base_facts": [
        "I captain the Blood Horkers.",
        "I drink at the Windpeak Inn in Dawnstar.",
        "Haldyn is our secret weapon, a powerful battlemage.",
        "Our base is at Japhet's Folly."
      ],
      "beat_facts": {}
    }
  },
