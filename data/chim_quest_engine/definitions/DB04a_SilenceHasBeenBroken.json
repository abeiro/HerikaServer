                                                            ],
                                             "beat_facts":  {
                                                                "SHOW_AMULET_TO_DELVIN":  [
                                                                                              "That amulet is only given to members of the Elder Council. I purchased it and provided a letter of credit as per my arrangement with the Brotherhood."
                                                                                          ]
                                                            }
                                         }
