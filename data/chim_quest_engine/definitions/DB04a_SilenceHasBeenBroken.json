    "title":  "The Silence Has Been Broken",
    "description":  "Astrid sends the player to Volunruud to meet Amaund Motierre, who commissions the Dark Brotherhood to assassinate the Emperor. The player delivers Motierre\u0027s sealed letter and jeweled amulet to Astrid, has Delvin Mallory appraise and buy the amulet, then returns to Astrid with a letter of credit.",
    "npc_facts":  {
                      "Astrid":  {
                                     "base_facts":  [
                                                        "I am the leader of the Dark Brotherhood sanctuary.",
                                                        "I was uncertain about the Night Mother\u0027s demands but have chosen to follow them.",
                                                        "I have a standard arrangement with Delvin Mallory for fencing goods."
                                                    ],
                                     "beat_facts":  {
                                                        "SPEAK_WITH_ASTRID":  [
                                                                                  "I have agreed to let the Listener meet Amaund Motierre at Volunruud as the Night Mother commanded."
                                                                              ],
                                                        "DELIVER_TO_ASTRID":  [
                                                                                  "Motierre wants us to kill several people leading up to the Emperor himself. This could bring the Brotherhood great glory."
                                                                              ],
                                                        "REPORT_TO_ASTRID":  [
                                                                                 "The amulet proves Motierre is on the Elder Council. He likely wants the Emperor dead to advance his own position. The first contract is to assassinate a bride at a wedding."
                                                                             ]
                                                    }
                                 },
                      "Amaund Motierre":  {
                                              "base_facts":  [
                                                                 "I am a member of the Elder Council.",
                                                                 "I have commissioned the Dark Brotherhood for a grand assassination plot.",
                                                                 "Rexus is my bodyguard."
                                                             ],
                                              "beat_facts":  {
                                                                 "MEET_MOTIERRE":  [
                                                                                       "I have given the Dark Brotherhood a sealed letter with instructions and a jeweled amulet to cover expenses. The ultimate target is the Emperor."
                                                                                   ]
                                                             }
                                          },
                      "Delvin Mallory":  {
                                             "base_facts":  [
                                                                "I am a fence for the Thieves Guild operating out of the Ragged Flagon.",
