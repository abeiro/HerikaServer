  "title": "Ancestral Worship",
  "description": "Help Golldir protect his ancestral tomb in Hillgrund's Tomb from the Dunmer necromancer Vals Veran, who has already killed Golldir's aunt Agna.",
  "npc_facts": {
    "Golldir": {
      "base_facts": [
        "I am a Nord standing outside Hillgrund's Tomb in Whiterun Hold.",
        "A Dunmer necromancer named Vals Veran is defiling my family's ancestral barrow inside.",
        "My aunt Agna went in alone to confront him but I was too afraid to follow.",
        "I have been terrified of this barrow ever since my father locked me inside as a child."
      ],
      "beat_facts": {
        "AGREE_TO_HELP": [
          "This adventurer agreed to help me stop Vals Veran and rescue Aunt Agna."
        ],
        "VALS_VERAN_DEFEATED": [
          "Vals Veran is dead, but Aunt Agna did not survive. I am grateful for the help."
        ],
        "QUEST_COMPLETE": [
          "I will stay near the tomb and spend my time hunting. I would follow this adventurer if asked.",
          "Quest completes after the player speaks with Golldir following Vals Veran's defeat.",
          "If Golldir is killed, the quest will still act as if it's active and that you can still \"talk to Golldir\" to finish the quest.",
          "A chain hanging from that plaque will open a secret door that leads to the main chamber."
        ]
      }
    }
  },
