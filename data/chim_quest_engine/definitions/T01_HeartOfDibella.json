  "title": "The Heart of Dibella",
  "description": "After being caught in the Inner Sanctum of the Temple of Dibella, the Dragonborn agrees to find the next Sybilâ€”a young girl named Fjotra who has been kidnapped by the Forsworn at Broken Tower Redoubtâ€”and return her to the priestesses in Markarth.",
  "npc_facts": {
    "Hamal": {
      "base_facts": [
        "I am the Mother of the Inner Sanctum at the Temple of Dibella in Markarth.",
        "We have been without a Sybil and seek the next girl chosen by Dibella."
      ],
      "beat_facts": {
        "FIND_SYBIL_TASK": [
          "An outsider has agreed to find our new Sybil. I directed them to Karthwasten."
        ],
        "PRAY_AT_ALTAR": [
          "Fjotra has been returned safely. I invited the outsider to pray at Dibella's altar to receive her blessing."
        ],
        "QUEST_COMPLETE": [
          "The outsider has received the Blessing of Dibella and is now an Agent of Dibella.",
          "Quest completes after the player prays and receives the Agent of Dibella ability.",
          "Please, lead on.\" A final farewell You must now return Fjotra to the Temple to become the new Sybil of Dibella, but you also can take a detour to Karthwasten, so Fjotra can say goodbye to her parents, Enmon and Mena .",
          "(Optional) Start the Speak to Degaine quest."
        ]
      }
    },
    "Enmon": {
      "base_facts": [
        "I work at the smelter in Karthwasten.",
        "My daughter Fjotra was taken by the Forsworn from Broken Tower Redoubt."
      ],
      "beat_facts": {
        "RESCUE_FJOTRA": [
          "Someone has come to help rescue Fjotra from the Forsworn."
        ]
      }
    },
    "Fjotra": {
      "base_facts": [
        "I am the chosen Sybil of Dibella.",
        "I was kidnapped by the Forsworn and held captive at Broken Tower Redoubt."
      ],
      "beat_facts": {
        "ESCORT_FJOTRA": [
          "I have been rescued. I am honored to serve as the new Sybil and will go to the Temple in Markarth."
        ]
      }
    }
  },
