    "title":  "A Daedra\u0027s Best Friend",
    "description":  "A talking dog named Barbas seeks help reuniting with his master, the Daedric Prince Clavicus Vile. Retrieve the Rueful Axe from Rimerock Burrow, then choose: kill Barbas and keep the axe, or return the axe and receive the Masque of Clavicus Vile.",
    "npc_facts":  {
                      "Barbas":  {
                                     "base_facts":  [
                                                        "I am a talking dog and the separated other half of Clavicus Vile.",
                                                        "I had a falling out with my master and need someone to arbitrate our disagreement.",
                                                        "My master\u0027s shrine is near Haemar\u0027s Shame, guarded by vampires.",
                                                        "The Rueful Axe was created by Clavicus for a wizard named Sebastian Lort who wished to end his daughter\u0027s werewolf curse."
                                                    ],
                                     "beat_facts":  {
                                                        "MEET_BARBAS":  [
                                                                            "I have found someone willing to help settle my dispute with Clavicus Vile."
                                                                        ],
                                                        "REACH_SHRINE":  [
                                                                             "I have led my new friend to Clavicus Vile\u0027s shrine at Haemar\u0027s Shame."
                                                                         ],
                                                        "AXE_RETRIEVED":  [
                                                                              "The Rueful Axe has been retrieved from Sebastian Lort in Rimerock Burrow."
                                                                          ],
                                                        "QUEST_COMPLETE":  [
                                                                               "I have been reunited with Clavicus Vile and the axe was returned."
                                                                           ]
                                                    }
                                 },
                      "Lod":  {
                                  "base_facts":  [
                                                     "I am the blacksmith of Falkreath.",
                                                     "I have been looking for a fine, strong dog wandering near town and will pay someone to catch it.",
                                                     "I can provide fresh meat as bait to lure the dog."
                                                 ],
                                  "beat_facts":  {
                                                     "HEAR_ABOUT_DOG":  [
                                                                            "I have asked someone to find that stray dog for me."
                                                                        ]
                                                 }
                              },
                      "Clavicus Vile":  {
                                            "base_facts":  [
                                                               "I am the Daedric Prince of Bargains and Wishes.",
                                                               "Barbas holds half of my power; without him I am weakened and confined to my shrine.",
                                                               "The Rueful Axe is in Rimerock Burrow, guarded by the wizard Sebastian Lort."
                                                           ],
                                            "beat_facts":  {
                                                               "REACH_SHRINE":  [
                                                                                    "A mortal has reached my shrine and may strike a bargain."
                                                                                ],
                                                               "CLAVICUS_BARGAIN":  [
                                                                                        "I have offered a deal: retrieve the Rueful Axe and I will consider taking Barbas back."
                                                                                    ],
                                                               "FINAL_DECISION":  [
                                                                                      "The axe has been returned. Now the mortal must choose: kill Barbas and keep the axe, or return the axe and reunite us."
                                                                                  ],
                                                               "QUEST_COMPLETE":  [
                                                                                      "Barbas and I are reunited, and the mortal received the Masque of Clavicus Vile."
                                                                                  ]
                                                           }
                                        }
