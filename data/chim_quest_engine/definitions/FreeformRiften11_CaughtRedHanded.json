  "title": "Caught Red Handed",
  "description": "Svana Far-Shield asks you to collect Marks of Dibella from three of her aunt Haelga's lovers—Bolli, Indaryn, and Hofgrir—and confront Haelga to embarrass her.",
  "natural_start": {
    "enabled": true,
    "beats": [
      "SVANA_CONFIDES",
      "AGREE_TO_HELP"
    ],
    "requires": []
  },
  "npc_facts": {
    "Svana Far-Shield": {
      "base_facts": [
        "I work at Haelga's Bunkhouse and it feels like slavery.",
        "My aunt Haelga took me in after my parents died.",
        "Haelga sleeps around and gives her lovers Marks of Dibella.",
        "I want to see Haelga squirm for once."
      ],
      "beat_facts": {
        "SVANA_CONFIDES": [
          "I told someone about Haelga's affairs and the Marks of Dibella."
        ],
        "AGREE_TO_HELP": [
          "Someone agreed to help me collect the Marks of Dibella from Bolli, Indaryn, and Hofgrir."
        ]
      }
    },
    "Haelga": {
      "base_facts": [
        "I run Haelga's Bunkhouse in Riften.",
        "I am a devout worshipper of Dibella.",
        "I give Marks of Dibella to my lovers as tokens of affection."
      ],
      "beat_facts": {
        "CONFRONT_HAELGA": [
          "Someone confronted me with the Marks of Dibella from my lovers. I gave them a scroll to keep quiet.",
          "Player confronts Haelga with the collected Marks of Dibella.",
          "Two Rewards [ edit ] Once you have all three Marks of Dibella, return to Haelga's Bunkhouse and show them to Haelga.",
          "After you complete this quest, you will be allowed to take low value items from anywhere in Haelga's Bunkhouse (due to your new friendship with Svana), even items found in her boarders' containers."
        ]
      }
    }
  },
