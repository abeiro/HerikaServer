    "title":  "The Dainty Sload",
    "description":  "Delvin Mallory assigns a special job from Solitude. Erikur, a wealthy thane, wants the Thieves Guild to frame Captain Volf of the Dainty Sload by planting the illegal substance Balmora Blue in his footlocker.",
    "npc_facts":  {
                      "Delvin Mallory":  {
                                             "base_facts":  [
                                                                "Delvin Mallory assigns special jobs for the Thieves Guild from the Ragged Flagon.",
                                                                "He received word from Solitude about an opportunity involving Erikur.",
                                                                "Completing special jobs helps the Guild regain influence in cities."
                                                            ],
                                             "beat_facts":  {
                                                                "QUEST_COMPLETE":  [
                                                                                       "Delvin is pleased that Captain Volf will be imprisoned and Erikur has pledged support for the Guild in Solitude."
                                                                                   ]
                                                            }
                                         },
                      "Erikur":  {
                                     "base_facts":  [
                                                        "Erikur is a wealthy thane and businessman in Solitude, found at the Blue Palace during the day.",
                                                        "He has requested the Thieves Guild\u0027s assistance with a matter of revenge."
                                                    ],
                                     "beat_facts":  {
                                                        "LEARN_THE_PLAN":  [
                                                                               "Captain Volf of the Dainty Sload broke a trade agreement with Erikur.",
                                                                               "Erikur wants to frame Captain Volf by planting Balmora Blue in his footlocker aboard the Dainty Sload."
                                                                           ],
                                                        "QUEST_COMPLETE":  [
                                                                               "Erikur is pleased with the framing of Captain Volf.",
                                                                               "He has pledged to open doors for the Thieves Guild in Solitude."
                                                                           ]
                                                    }
                                 },
                      "Sabine Nytte":  {
                                           "base_facts":  [
                                                              "Sabine Nytte is a crew member aboard the pirate ship Red Wave docked outside the East Empire Company Warehouse.",
                                                              "She deals in rare contraband including Balmora Blue."
                                                          ],
                                           "beat_facts":  {
                                                              "ACQUIRE_BALMORA_BLUE":  [
                                                                                           "Sabine sells Balmora Blue for 1500 gold.",
                                                                                           "The Balmora Blue is hidden in a locked chest under the docks near the Red Wave."
                                                                                       ]
                                                          }
                                       }
                  },
