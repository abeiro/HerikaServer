    "title":  "Laid to Rest",
    "description":  "Investigate a mysterious house fire in Morthal that killed Hroggar\u0027s wife and child, uncover a vampire plot led by Alva and her master Movarth, and defend the town from the vampire threat.",
    "npc_facts":  {
                      "Idgrod Ravencrone":  {
                                                "base_facts":  [
                                                                   "I am the Jarl of Morthal.",
                                                                   "A house fire recently killed Hroggar\u0027s wife and daughter.",
                                                                   "I need someone trustworthy to investigate the fire."
                                                               ],
                                                "beat_facts":  {
                                                                   "QUEST_STARTED":  [
                                                                                         "I have asked someone to investigate the burned house."
                                                                                     ],
                                                                   "JOURNAL_SHOWN":  [
                                                                                         "Alva is a vampire who enthralled Hroggar and killed his family.",
                                                                                         "Movarth plans to enslave the entire town of Morthal.",
                                                                                         "I have sent a group led by Thonnir to deal with Movarth."
                                                                                     ],
                                                                   "QUEST_COMPLETE":  [
                                                                                          "The vampire threat has been eliminated.",
                                                                                          "Morthal is safe now."
                                                                                      ]
                                                               }
                                            },
                      "Thonnir":  {
                                      "base_facts":  [
                                                         "My wife Laelette disappeared. She said she was joining the Stormcloaks.",
                                                         "She was spending a lot of time with Alva before she left."
                                                     ],
                                      "beat_facts":  {
                                                         "HELGI_AND_LAELETTE":  [
                                                                                    "Laelette was turned into a vampire by Alva.",
                                                                                    "My wife is dead.",
                                                                                    "I need proof that Alva is a vampire before I will believe it."
                                                                                ],
                                                         "JOURNAL_SHOWN":  [
                                                                               "Alva was behind everything that happened to Laelette.",
                                                                               "I will lead the mob against Movarth."
                                                                           ],
                                                         "MOVARTH_DEFEATED":  [
                                                                                  "Movarth is dead. Laelette can rest now."
                                                                              ]
                                                     }
                                  },
                      "Hroggar":  {
                                      "base_facts":  [
                                                         "My wife and daughter died in a house fire.",
                                                         "Alva and I are together now."
                                                     ],
                                      "beat_facts":  {
                                                         "ALVA_EVIDENCE":  [
                                                                               "I was enthralled by Alva. She made me turn a blind eye to everything."
                                                                           ]
                                                     }
                                  },
                      "Alva":  {
                                   "base_facts":  [
                                                      "I live in Morthal.",
                                                      "Hroggar and I are together."
                                                  ],
                                   "beat_facts":  {
                                                      "ALVA_EVIDENCE":  [
                                                                            "I am a vampire serving Movarth.",
                                                                            "I enthralled Hroggar and had his family killed.",
                                                                            "I planned to enslave the town for our blood."
                                                                        ]
                                                  }
                               }
