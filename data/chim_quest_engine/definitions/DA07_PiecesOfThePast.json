    "title":  "Pieces of the Past",
    "description":  "Silus Vesuius, curator of the Mythic Dawn museum in Dawnstar, tasks the player with retrieving three scattered pieces of Mehrunes\u0027 Razor. Once reunited, Silus seeks to reforge the dagger at the Shrine of Mehrunes Dagon, where the Daedric Prince demands Silus be killed in exchange for the restored weapon.",
    "npc_facts":  {
                      "Silus Vesuius":  {
                                            "base_facts":  [
                                                               "I run the Museum of the Mythic Dawn in my home in Dawnstar.",
                                                               "My ancestors were members of the Mythic Dawn cult that opened the Oblivion gates.",
                                                               "I have spent my life collecting artifacts tied to the Mythic Dawn.",
                                                               "I seek the three pieces of Mehrunes\u0027 Razor: the pommel, the blade shards, and the hilt."
                                                           ],
                                            "beat_facts":  {
                                                               "MEET_SILUS":  [
                                                                                  "A visitor has come to my museum. Perhaps they can help me retrieve the Razor pieces."
                                                                              ],
                                                               "ACCEPT_QUEST":  [
                                                                                    "This adventurer has agreed to retrieve the three pieces of Mehrunes\u0027 Razor for me."
                                                                                ],
                                                               "ALL_PIECES_RETURNED":  [
                                                                                           "All three pieces of the Razor have been returned. We must reforge it at the Shrine of Mehrunes Dagon."
                                                                                       ],
                                                               "SPEAK_TO_DAGON":  [
                                                                                      "Mehrunes Dagon has spoken and demands a sacrifice before reforging the Razor."
                                                                                  ]
                                                           }
                                        },
                      "Mehrunes Dagon":  {
                                             "base_facts":  [
                                                                "I am Mehrunes Dagon, Daedric Prince of Destruction, Change, Revolution, Energy, and Ambition.",
                                                                "My Razor was broken into three pieces and scattered across Skyrim long ago."
                                                            ],
                                             "beat_facts":  {
                                                                "SPEAK_TO_DAGON":  [
                                                                                       "A mortal seeks to reforge my Razor. Kill the one who brought the pieces, and the weapon shall be yours."
                                                                                   ],
                                                                "KILL_SILUS":  [
                                                                                   "The mortal has proven worthy. I shall reforge my Razor and grant it to my new champion."
                                                                               ]
                                                            }
                                         }
                  },
