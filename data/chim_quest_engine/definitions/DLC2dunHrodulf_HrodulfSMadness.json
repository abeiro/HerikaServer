    "title":  "Hrodulf\u0027s Madness",
    "description":  "A non-journal quest investigating the charred ruins of Hrodulf\u0027s House on Solstheim, uncovering the tragic fate of Hrodulf and his lover Bjornolfr through letters and a journal, and discovering a hidden Dwemer chamber beneath the house that drove Hrodulf mad.",
    "npc_facts":  {
                      "Hrodulf":  {
                                      "base_facts":  [
                                                         "I moved into a house on Solstheim and became obsessed with a strange rumbling from beneath the basement.",
                                                         "I heard a calling from the depths and broke through the wall behind my bookshelf to find the source.",
                                                         "I begged Bjornolfr to stay away from the house for his own safety."
                                                     ],
                                      "beat_facts":  {
                                                         "READ_HRODULF_JOURNAL":  [
                                                                                      "My journal reveals I grew obsessed with voices from beneath the basement and bought digging tools."
                                                                                  ],
                                                         "DISCOVER_DWEMER_CHAMBER":  [
                                                                                         "I dug a tunnel to a Dwemer chamber with still-functioning machines that likely drove me mad."
                                                                                     ],
                                                         "FIND_HRODULF":  [
                                                                              "I tried to escape Solstheim by canoe but was killed by a burnt spriggan on the coast south of my house."
                                                                          ]
                                                     }
                                  },
                      "Bjornolfr":  {
                                        "base_facts":  [
                                                           "I am from Solitude and Hrodulf is my lover.",
                                                           "I wrote to Hrodulf begging him to leave Solstheim and return to Solitude."
                                                       ],
                                        "beat_facts":  {
                                                           "READ_BJORNOLFR_LETTER":  [
                                                                                         "My letter to Hrodulf shows great concern for his welfare and pleads with him to return to Solitude."
                                                                                     ],
                                                           "DISCOVER_DWEMER_CHAMBER":  [
                                                                                           "I traveled to Solstheim to find Hrodulf but was killed by reavers in the tunnel beneath his house."
                                                                                       ]
                                                       }
                                    }
