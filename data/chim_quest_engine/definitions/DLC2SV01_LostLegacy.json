    "title":  "Lost Legacy",
    "description":  "Tharstan, an elderly historian living in Skaal Village, discovered the entrance to Vahlok\u0027s Tomb after an earthquake. He hires the player as protection while exploring the ancient crypt, which turns out to be the resting place of the Dragon Priest Vahlok the Jailor.",
    "npc_facts":  {
                      "Tharstan":  {
                                       "base_facts":  [
                                                          "I am an elderly historian and author living in Skaal Village.",
                                                          "I married Fanari Strong-Voice, the leader of the Skaal.",
                                                          "I wrote Children of the All-Maker about Skaal traditions.",
                                                          "I discovered the entrance to Vahlok\u0027s Tomb after an earthquake caused by the eruption of Red Mountain.",
                                                          "I need someone to accompany me as protection while I explore the tomb."
                                                      ],
                                       "beat_facts":  {
                                                          "QUEST_ACCEPTED":  [
                                                                                 "The player agreed to accompany me to Vahlok\u0027s Tomb. I asked them to meet me there."
                                                                             ],
                                                          "TALK_TO_THARSTAN_TOMB":  [
                                                                                        "The player arrived at the tomb. I showed them the inscription about a sacrifice and asked them to open the sealed doors."
                                                                                    ],
                                                          "EXPLORE_TOMB":  [
                                                                               "We are exploring the tomb together. The player solved the sacrifice riddle and opened the passages."
                                                                           ],
                                                          "FIND_BURIAL_CHAMBER":  [
                                                                                      "We found the puzzle door and I deciphered the combination from the wall etchings: wind, moon, fire with scales."
                                                                                  ],
                                                          "DEFEAT_VAHLOK":  [
                                                                                "The player defeated Vahlok the Jailor, a Dragon Priest who guarded this tomb."
                                                                            ],
                                                          "TALK_TO_THARSTAN_REWARD":  [
                                                                                          "I rewarded the player with 1000 gold for their help. I will stay in the tomb to study the word wall further."
                                                                                      ]
                                                      }
