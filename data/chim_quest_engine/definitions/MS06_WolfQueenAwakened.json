    "title":  "The Wolf Queen Awakened",
    "description":  "Potema the Wolf Queen has escaped her binding and is gathering power in her catacombs beneath Solitude. Falk Firebeard sends the player to Styrr for the key, then into Potema\u0027s Catacombs to defeat her and retrieve her remains for sanctification.",
    "npc_facts":  {
                      "Falk Firebeard":  {
                                             "base_facts":  [
                                                                "I am the steward of the Blue Palace in Solitude.",
                                                                "Potema the Wolf Queen has escaped her binding ritual and must be stopped.",
                                                                "I sent a letter warning of the threat and requesting the adventurer\u0027s return.",
                                                                "Styrr the priest of Arkay can provide guidance and the key to Potema\u0027s Catacombs."
                                                            ],
                                             "beat_facts":  {
                                                                "MS06_STAGE_50":  [
                                                                                      "I have sent the adventurer to speak with Styrr about how to stop Potema."
                                                                                  ],
                                                                "MS06_COMPLETE":  [
                                                                                      "Potema has been defeated. I rewarded the adventurer with gold and the Shield of Solitude on behalf of the jarl."
                                                                                  ]
                                                            }
                                         },
                      "Styrr":  {
                                    "base_facts":  [
                                                       "I am a priest of Arkay at Solitude\u0027s Hall of the Dead.",
                                                       "Potema was a formidable necromancer and former Queen of Solitude who raised armies of the dead.",
                                                       "Potema\u0027s remains must be sanctified to prevent her full resurrection.",
                                                       "I hold the key to Potema\u0027s Catacombs beneath the Temple of the Divines."
                                                   ],
                                    "beat_facts":  {
                                                       "MS06_STAGE_50":  [
                                                                             "I gave the adventurer the key to Potema\u0027s Catacombs and the spell Turn Undead."
                                                                         ],
                                                       "MS06_STAGE_150":  [
                                                                              "I have received Potema\u0027s remains and will bless them to prevent her return."
                                                                          ]
                                                   }
                                }
