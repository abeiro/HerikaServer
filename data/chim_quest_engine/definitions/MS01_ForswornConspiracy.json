    "quest_editor_id":  "MS01",
    "title":  "The Forsworn Conspiracy",
    "description":  "Investigate the Forsworn conspiracy in Markarth after a woman named Margret is attacked in the marketplace. Eltrys asks you to uncover who is behind the Forsworn attacks and why the guards do nothing.",
    "npc_facts":  {
                      "Eltrys":  {
                                     "base_facts":  [
                                                        "I am a Breton living in Markarth.",
                                                        "My father was killed by the Forsworn.",
                                                        "I have spent my whole life trying to find out why the Forsworn attack and why the guards do nothing.",
                                                        "I meet contacts at the Shrine of Talos beneath the Temple of Dibella."
                                                    ],
                                     "beat_facts":  {
                                                        "NOTE_AND_MEETING":  [
                                                                                 "I slipped a note to someone who witnessed the marketplace attack and asked them to meet me at the Shrine of Talos."
                                                                             ],
                                                        "INVESTIGATION_BEGINS":  [
                                                                                     "I have hired someone to investigate the Forsworn conspiracy and will pay for any information they bring."
                                                                                 ],
                                                        "RETURN_TO_ELTRYS":  [
                                                                                 "I am compiling all the evidence my investigator has uncovered about the Forsworn conspiracy."
                                                                             ]
                                                    }
                                 },
                      "Margret":  {
                                      "base_facts":  [
                                                         "I was attacked in the Markarth marketplace by a man named Weylin.",
                                                         "I rented a room at the Silver-Blood Inn."
                                                     ],
                                      "beat_facts":  {
                                                         "MARGRET_EVIDENCE":  [
                                                                                  "I revealed that I am an Imperial spy working with General Tullius to investigate the Silver-Blood family and the Treasury House.",
                                                                                  "Thonar Silver-Blood arranged for my murder."
                                                                              ]
                                                     }
                                  },
                      "Weylin":  {
                                     "base_facts":  [
                                                        "I was a Breton who worked as a smelter at Cidhna Mine.",
                                                        "I lived in the Warrens in Markarth.",
                                                        "I shouted \u0027The Reach belongs to the Forsworn\u0027 when I attacked Margret."
                                                    ],
                                     "beat_facts":  {

                                                    }
                                 },
                      "Thonar Silver-Blood":  {
                                                  "base_facts":  [
                                                                     "I am Thonar Silver-Blood, head of the Treasury House.",
                                                                     "The Silver-Blood family controls Markarth\u0027s wealth and Cidhna Mine."
                                                                 ],
                                                  "beat_facts":  {
                                                                     "THONAR_EVIDENCE":  [
                                                                                             "I admitted that I have been controlling the Forsworn by imprisoning their king Madanach in Cidhna Mine.",
                                                                                             "Madanach has become out of control and ordered the attack on my wife Betrid."
                                                                                         ]
                                                                 }
                                              },
                      "Nepos the Nose":  {
                                             "base_facts":  [
                                                                "I am Nepos the Nose, an old man living in Nepos\u0027s House in Markarth.",
                                                                "I am a Forsworn agent loyal to Madanach, the King in Rags.",
                                                                "I receive orders from Madanach, who is imprisoned in Cidhna Mine."
                                                            ],
                                             "beat_facts":  {
                                                                "NEPOS_EVIDENCE":  [
                                                                                       "I confessed that I am the \u0027N\u0027 who directed Weylin to attack Margret on Madanach\u0027s orders.",
                                                                                       "I ordered Dryston to rough up anyone investigating the conspiracy."
                                                                                   ]
                                                            }
                                         }
                  },
